# Trickreport — staging environment configuration.
# Copy to .env.staging and edit before running:
#   docker compose -f docker-compose.staging.yml --env-file .env.staging up -d

# ─── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=trickreport_staging
POSTGRES_USER=trickreport
POSTGRES_PASSWORD=change-me-in-staging

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-strong-random-value
JWT_EXP_HOURS=8

# ─── Bootstrap admin ───────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@staging.local
ADMIN_PASSWORD=change-me-in-staging

# ─── Networking ────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://staging.local,http://localhost:8081
# Host port mapped to Caddy inside the container.
STAGING_PORT=8081
# Use secure cookies only when serving over HTTPS.
COOKIE_SECURE=false

# ─── Timezone (used by backup service when overlaid) ───────────────────────────
TZ=UTC
