## Trickreport — .gitignore

# Dependencies
node_modules/
.pnp
.pnp.js

# Astro build
frontend/dist/
frontend/.astro/

# Environment files
.env
.env.local
.env.onpremise
backend/.env
frontend/.env
frontend/.env.local

# Go build
backend/dist/
backend/*.exe

# Go coverage
backend/*cov*
backend/coverage

# Docker
*.log

# Backups (keep directory, ignore contents)
backups/*
!backups/.gitkeep

# OS
.DS_Store
Thumbs.db

# IDE / agent configs
.vscode/
.idea/
*.swp
.atl/
.devin/
