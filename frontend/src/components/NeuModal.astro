---
// Modal dialog with backdrop and neu styling. Closes on backdrop click and
// Escape key. Props: title, open. Slots: default (content), footer.
export interface Props {
  title?: string;
  open?: boolean;
  class?: string;
}

const { title = '', open = false, class: className = '' } = Astro.props;
---

<div
  id="neu-modal"
  class={`modal-backdrop ${className}`}
  style={open ? '' : 'display:none;'}
  role="dialog"
  aria-modal="true"
  aria-labelledby={title ? 'neu-modal-title' : undefined}
>
  <div class="neu-modal" id="neu-modal-panel">
    <div class="neu-modal-header">
      {title && <h2 id="neu-modal-title" class="text-lg font-semibold">{title}</h2>}
      <button
        type="button"
        class="neu-modal-close"
        aria-label="Close dialog"
        data-neu-modal-close
      >×</button>
    </div>
    <div class="neu-modal-body">
      <slot />
    </div>
    {Astro.slots.has('footer') && (
      <div class="neu-modal-footer mt-6 flex justify-end gap-3">
        <slot name="footer" />
      </div>
    )}
  </div>
</div>

<script>
  function setupModal() {
    const modal = document.getElementById('neu-modal');
    if (!modal || modal.dataset.bound) return;
    modal.dataset.bound = '1';

    const panel = document.getElementById('neu-modal-panel');

    function close() {
      if (!modal) return;
      modal.style.display = 'none';
    }

    modal.addEventListener('click', (e) => {
      if (e.target === modal) close();
    });

    modal.querySelectorAll('[data-neu-modal-close]').forEach((btn) => {
      btn.addEventListener('click', close);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && modal.style.display !== 'none') {
        close();
      }
    });
  }

  setupModal();
</script>
