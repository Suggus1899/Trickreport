---
export interface Props {
  variant?: 'default' | 'success' | 'warning' | 'danger' | 'info';
  class?: string;
}

const { variant = 'default', class: className = '' } = Astro.props;

const variants: Record<string, string> = {
  default: 'text-[var(--text-main)] shadow-[3px_3px_6px_#a3b1c6,-3px_-3px_6px_#ffffff]',
  success: 'text-emerald-700 shadow-[3px_3px_6px_#34a85340,-3px_-3px_6px_#ffffff]',
  warning: 'text-amber-700 shadow-[3px_3px_6px_#ffcc0040,-3px_-3px_6px_#ffffff]',
  danger: 'text-rose-700 shadow-[3px_3px_6px_#ff5a5a40,-3px_-3px_6px_#ffffff]',
  info: 'text-indigo-700 shadow-[3px_3px_6px_#6d5dfc40,-3px_-3px_6px_#ffffff]',
};

const classes = `inline-flex items-center px-3 py-1 rounded-full text-xs font-bold neu-convex ${variants[variant]} ${className}`;
---

<span class={classes}>
  <slot />
</span>
