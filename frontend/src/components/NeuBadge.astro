---
export interface Props {
  variant?: 'default' | 'success' | 'warning' | 'danger' | 'info';
  class?: string;
}

const { variant = 'default', class: className = '' } = Astro.props;

const variants: Record<string, string> = {
  default: 'text-main shadow-badge-default',
  success: 'text-emerald-700 shadow-badge-success',
  warning: 'text-amber-700 shadow-badge-warning',
  danger: 'text-rose-700 shadow-badge-danger',
  info: 'text-indigo-700 shadow-badge-info',
};

const classes = `inline-flex items-center px-3 py-1 rounded-full text-xs font-bold neu-convex ${variants[variant]} ${className}`;
---

<span class={classes}>
  <slot />
</span>
