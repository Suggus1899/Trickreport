---
export interface Props {
  name: string;
  label?: string;
  type?: 'text' | 'email' | 'password' | 'textarea';
  placeholder?: string;
  required?: boolean;
  value?: string;
  class?: string;
  error?: string;
  helperText?: string;
  maxChars?: number;
  showPasswordToggle?: boolean;
}

const {
  name,
  label,
  type = 'text',
  placeholder,
  required,
  value = '',
  class: className = '',
  error = '',
  helperText = '',
  maxChars,
  showPasswordToggle = false,
} = Astro.props;

const helperId = `${name}-helper`;
const errorId = `${name}-error`;
const describedBy = error ? errorId : helperText ? helperId : undefined;
const inputClass = error ? 'neu-input-error' : '';
const isPasswordToggle = showPasswordToggle && type === 'password';
---

<div class={`flex flex-col gap-2 ${className}`}>
  {label && (
    <label for={name} class="text-sm font-semibold text-[var(--text-main)] ml-1">
      {label}{required && <span class="text-[var(--danger)]"> *</span>}
    </label>
  )}
  {type === 'textarea' ? (
    <textarea
      id={name}
      name={name}
      placeholder={placeholder}
      required={required}
      rows="4"
      class={inputClass}
      aria-invalid={error ? 'true' : undefined}
      aria-describedby={describedBy}
      maxlength={maxChars}
    >{value}</textarea>
  ) : isPasswordToggle ? (
    <div class="neu-input-wrapper">
      <input
        id={name}
        name={name}
        type={type}
        placeholder={placeholder}
        required={required}
        value={value}
        class={inputClass}
        aria-invalid={error ? 'true' : undefined}
        aria-describedby={describedBy}
        maxlength={maxChars}
      />
      <button
        type="button"
        class="neu-password-toggle"
        data-toggle-for={name}
        aria-label="Show password"
        aria-pressed="false"
      >
        <svg class="eye-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
          <circle cx="12" cy="12" r="3"></circle>
        </svg>
        <svg class="eye-closed" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none">
          <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path>
          <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path>
          <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path>
          <line x1="2" y1="2" x2="22" y2="22"></line>
        </svg>
      </button>
    </div>
  ) : (
    <input
      id={name}
      name={name}
      type={type}
      placeholder={placeholder}
      required={required}
      value={value}
      class={inputClass}
      aria-invalid={error ? 'true' : undefined}
      aria-describedby={describedBy}
      maxlength={maxChars}
    />
  )}
  {maxChars && (
    <div class="flex items-center">
      <span class="neu-char-count" data-char-count-for={name}>{(value || '').length}/{maxChars}</span>
    </div>
  )}
  {error && (
    <p id={errorId} class="neu-input-error-text">{error}</p>
  )}
  {!error && helperText && (
    <p id={helperId} class="neu-input-helper">{helperText}</p>
  )}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-char-count-for]').forEach((counter) => {
    const targetId = counter.dataset.charCountFor;
    if (!targetId) return;
    const input = document.getElementById(targetId) as HTMLInputElement | HTMLTextAreaElement | null;
    if (!input) return;
    const max = input.getAttribute('maxlength');
    if (!max) return;
    const update = () => {
      counter.textContent = `${(input.value || '').length}/${max}`;
    };
    input.addEventListener('input', update);
    update();
  });

  document.querySelectorAll<HTMLButtonElement>('.neu-password-toggle').forEach((btn) => {
    const targetId = btn.dataset.toggleFor;
    if (!targetId) return;
    const input = document.getElementById(targetId) as HTMLInputElement | null;
    if (!input) return;
    const eyeOpen = btn.querySelector('.eye-open') as SVGElement | null;
    const eyeClosed = btn.querySelector('.eye-closed') as SVGElement | null;
    btn.addEventListener('click', () => {
      const isPassword = input.type === 'password';
      input.type = isPassword ? 'text' : 'password';
      btn.setAttribute('aria-pressed', String(isPassword));
      btn.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
      if (eyeOpen) eyeOpen.style.display = isPassword ? 'none' : '';
      if (eyeClosed) eyeClosed.style.display = isPassword ? '' : 'none';
    });
  });
</script>
