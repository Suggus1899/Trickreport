---
// Modal listing all available keyboard shortcuts. Toggled by the "?" key
// (registered in src/lib/keyboard.ts and wired up in Layout.astro).
---

<div id="keyboard-help" class="modal-overlay" style="display:none;">
  <div class="modal-card neu-raised rounded-3xl p-6 w-full max-w-lg">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold">Keyboard shortcuts</h2>
      <button type="button" id="kh-close" class="neu-transition px-3 py-1 rounded-xl font-semibold neu-convex text-muted text-sm" aria-label="Close">Esc</button>
    </div>
    <div id="kh-list" class="flex flex-col gap-2"></div>
  </div>
</div>

<script is:inline>
  (function () {
    const overlay = document.getElementById('keyboard-help');
    const list = document.getElementById('kh-list');
    const closeBtn = document.getElementById('kh-close');
    if (!overlay) return;

    const shortcuts = [
      { keys: ['g', 'd'], desc: 'Go to Dashboard' },
      { keys: ['g', 't'], desc: 'Go to Tickets' },
      { keys: ['g', 'a'], desc: 'Go to Knowledge Base' },
      { keys: ['g', 'u'], desc: 'Go to Users (admin)' },
      { keys: ['n'], desc: 'New Ticket' },
      { keys: ['/'], desc: 'Focus search' },
      { keys: ['?'], desc: 'Show this help' },
      { keys: ['Esc'], desc: 'Close dialogs / help' },
    ];

    function render() {
      list.innerHTML = shortcuts.map((s) =>
        `<div class="kh-row flex items-center justify-between gap-4 py-2" style="border-bottom:1px solid rgba(163,177,198,0.2);">
          <span class="text-sm text-main">${s.desc}</span>
          <span class="kh-keys flex items-center gap-1">${s.keys.map((k) => `<kbd class="kh-key">${k}</kbd>`).join('<span class="text-muted text-xs">+</span>')}</span>
        </div>`
      ).join('');
    }
    render();

    function open() { overlay.style.display = 'flex'; }
    function close() { overlay.style.display = 'none'; }

    closeBtn.addEventListener('click', close);
    overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });

    // Expose toggle for the keyboard handler in Layout.astro.
    window.__toggleKeyboardHelp = function () {
      overlay.style.display = overlay.style.display === 'none' || !overlay.style.display ? 'flex' : 'none';
    };
    window.__closeKeyboardHelp = close;
    window.__openKeyboardHelp = open;
  })();
</script>

<style>
  .kh-key {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.6rem;
    padding: 0.15rem 0.4rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-main);
    background: var(--bg-base);
    box-shadow: var(--shadow-sunken);
    border-radius: 0.4rem;
    font-family: 'Fira Code', monospace;
  }
</style>
