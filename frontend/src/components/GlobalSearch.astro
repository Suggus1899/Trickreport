---
// Global search bar with debounced autocomplete and keyboard navigation.
// Calls /api/v1/search?q=... and falls back to /tickets + /articles when
// the unified endpoint is unavailable. Renders grouped dropdown results.
import { API_URL } from '../lib/api';

// The auth cookie is httpOnly, so the token can't be read by client-side JS.
// Read it here (server-side) and inject it into the inline script.
const token = Astro.cookies.get('trickreport_token')?.value || '';
---

<div class="global-search" id="global-search">
  <span class="gs-icon" aria-hidden="true">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
  </span>
  <input
    type="text"
    id="gs-input"
    class="gs-input"
    placeholder="Search tickets, articles…  (press /)"
    autocomplete="off"
    role="combobox"
    aria-expanded="false"
    aria-controls="gs-results"
  />
  <kbd class="gs-hint">/</kbd>
  <div id="gs-results" class="gs-results" role="listbox" style="display:none;"></div>
</div>

<style>
  .global-search {
    position: relative;
    flex: 1;
    min-width: 14rem;
    max-width: 28rem;
  }
  .gs-icon {
    position: absolute;
    left: 0.875rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    display: flex;
    pointer-events: none;
  }
  .gs-input {
    width: 100%;
    padding: 0.625rem 2.5rem 0.625rem 2.5rem !important;
    font-size: 0.875rem !important;
  }
  .gs-hint {
    position: absolute;
    right: 0.625rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.7rem;
    color: var(--text-muted);
    background: var(--bg-base);
    box-shadow: var(--shadow-sunken);
    border-radius: 0.375rem;
    padding: 0.1rem 0.4rem;
    pointer-events: none;
  }
  .gs-results {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    right: 0;
    z-index: 50;
    background: var(--bg-base);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-raised);
    padding: 0.5rem;
    max-height: 24rem;
    overflow-y: auto;
  }
  .gs-group-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    padding: 0.5rem 0.75rem 0.25rem;
    font-weight: 700;
  }
  .gs-item {
    display: flex;
    flex-direction: column;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    text-decoration: none;
    color: var(--text-main);
  }
  .gs-item:hover,
  .gs-item.active {
    background: rgba(109, 93, 252, 0.12);
    text-decoration: none;
  }
  .gs-item-title {
    font-weight: 600;
    font-size: 0.875rem;
  }
  .gs-item-sub {
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .gs-empty {
    padding: 1rem;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.85rem;
  }
</style>

<script is:inline define:vars={{ API_URL, token }}>
  (function () {
    const root = document.getElementById('global-search');
    if (!root) return;
    const input = document.getElementById('gs-input');
    const results = document.getElementById('gs-results');
    let debounce = null;
    let items = []; // flat list of { el, href }
    let activeIndex = -1;

    async function runSearch(q) {
      if (!q) { hide(); return; }
      const headers = { 'Content-Type': 'application/json', 'X-Tenant-ID': 'default' };
      if (token) headers['Authorization'] = 'Bearer ' + token;
      try {
        const res = await fetch(`${API_URL}/api/v1/search?q=${encodeURIComponent(q)}`, {
          headers, credentials: 'include',
        });
        if (res.ok) {
          const data = await res.json();
          render(data.tickets || [], data.articles || []);
          return;
        }
        // Fallback: search tickets + articles separately.
        await fallbackSearch(q, headers);
      } catch (err) {
        await fallbackSearch(q, headers);
      }
    }

    async function fallbackSearch(q, headers) {
      try {
        const [tRes, aRes] = await Promise.all([
          fetch(`${API_URL}/api/v1/tickets?q=${encodeURIComponent(q)}`, { headers, credentials: 'include' }),
          fetch(`${API_URL}/api/v1/articles?q=${encodeURIComponent(q)}`, { headers, credentials: 'include' }),
        ]);
        const tickets = tRes.ok ? await tRes.json() : [];
        const articles = aRes.ok ? await aRes.json() : [];
        // Client-side filter for fallback.
        const ql = q.toLowerCase();
        const ft = (tickets || []).filter((x) => (x.title || '').toLowerCase().includes(ql)).slice(0, 6);
        const fa = (articles || []).filter((x) => (x.title || '').toLowerCase().includes(ql)).slice(0, 6);
        render(ft, fa);
      } catch (err) {
        hide();
      }
    }

    function render(tickets, articles) {
      items = [];
      const hasT = tickets && tickets.length;
      const hasA = articles && articles.length;
      if (!hasT && !hasA) {
        results.innerHTML = '<div class="gs-empty">No results found.</div>';
        results.style.display = 'block';
        input.setAttribute('aria-expanded', 'true');
        return;
      }
      let html = '';
      if (hasT) {
        html += '<div class="gs-group-label">Tickets</div>';
        tickets.slice(0, 6).forEach((t) => {
          const href = `/tickets/${t.id}`;
          html += `<a class="gs-item" href="${href}" data-href="${href}">
            <span class="gs-item-title">${escapeHtml(t.title || t.id)}</span>
            <span class="gs-item-sub">${escapeHtml(t.status || '')} · ${escapeHtml(t.priority || '')}</span>
          </a>`;
        });
      }
      if (hasA) {
        html += '<div class="gs-group-label">Articles</div>';
        articles.slice(0, 6).forEach((a) => {
          const href = `/articles/${a.id}`;
          html += `<a class="gs-item" href="${href}" data-href="${href}">
            <span class="gs-item-title">${escapeHtml(a.title || a.id)}</span>
            <span class="gs-item-sub">${escapeHtml(a.category || '')}</span>
          </a>`;
        });
      }
      results.innerHTML = html;
      results.style.display = 'block';
      input.setAttribute('aria-expanded', 'true');
      results.querySelectorAll('.gs-item').forEach((el) => items.push({ el, href: el.getAttribute('data-href') }));
      activeIndex = -1;
    }

    function escapeHtml(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    function hide() {
      results.style.display = 'none';
      results.innerHTML = '';
      items = [];
      activeIndex = -1;
      input.setAttribute('aria-expanded', 'false');
    }

    function setActive(i) {
      if (!items.length) return;
      activeIndex = (i + items.length) % items.length;
      items.forEach((it, idx) => it.el.classList.toggle('active', idx === activeIndex));
      const el = items[activeIndex].el;
      el.scrollIntoView({ block: 'nearest' });
    }

    input.addEventListener('input', () => {
      const q = input.value.trim();
      clearTimeout(debounce);
      if (!q) { hide(); return; }
      debounce = setTimeout(() => runSearch(q), 300);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); setActive(activeIndex + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(activeIndex - 1); }
      else if (e.key === 'Enter') {
        if (activeIndex >= 0 && items[activeIndex]) {
          e.preventDefault();
          window.location.href = items[activeIndex].href;
        }
      } else if (e.key === 'Escape') {
        hide();
        input.blur();
      }
    });

    // "/" focuses the search from anywhere (unless typing in a field).
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && !isTyping(e.target)) {
        e.preventDefault();
        input.focus();
        input.select();
      }
    });

    function isTyping(el) {
      if (!(el instanceof HTMLElement)) return false;
      const tag = el.tagName.toLowerCase();
      return tag === 'input' || tag === 'textarea' || tag === 'select' || el.isContentEditable;
    }

    // Close when clicking outside.
    document.addEventListener('click', (e) => {
      if (!root.contains(e.target)) hide();
    });
  })();
</script>
