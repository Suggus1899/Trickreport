---
export interface Props {
  currentPage: number;
  totalPages: number;
  href: string;
}

const { currentPage, totalPages, href } = Astro.props;
const sep = href.includes('?') ? '&' : '?';

function pageHref(page: number): string {
  return `${href}${sep}page=${page}`;
}

function pageList(): (number | '...')[] {
  const pages: (number | '...')[] = [];
  if (totalPages <= 7) {
    for (let i = 1; i <= totalPages; i++) pages.push(i);
    return pages;
  }
  pages.push(1);
  if (currentPage > 3) pages.push('...');
  const start = Math.max(2, currentPage - 1);
  const end = Math.min(totalPages - 1, currentPage + 1);
  for (let i = start; i <= end; i++) pages.push(i);
  if (currentPage < totalPages - 2) pages.push('...');
  pages.push(totalPages);
  return pages;
}

const pages = pageList();
const hasPrev = currentPage > 1;
const hasNext = currentPage < totalPages;
const itemClass = 'inline-flex items-center justify-center h-8 min-w-8 px-2 rounded-md text-sm';
---

<nav class="flex items-center gap-1 mt-6" aria-label="Pagination">
  {hasPrev ? (
    <a href={pageHref(currentPage - 1)} aria-label="Previous page" rel="prev" class={`${itemClass} border hover:bg-muted`}>‹</a>
  ) : (
    <span class={`${itemClass} text-muted-foreground`} aria-disabled="true">‹</span>
  )}

  {pages.map((p) => (
    p === '...' ? (
      <span class={`${itemClass} text-muted-foreground`}>…</span>
    ) : p === currentPage ? (
      <span class={`${itemClass} bg-primary text-primary-foreground font-semibold`} aria-current="page">{p}</span>
    ) : (
      <a href={pageHref(p)} aria-label={`Page ${p}`} class={`${itemClass} border hover:bg-muted`}>{p}</a>
    )
  ))}

  {hasNext ? (
    <a href={pageHref(currentPage + 1)} aria-label="Next page" rel="next" class={`${itemClass} border hover:bg-muted`}>›</a>
  ) : (
    <span class={`${itemClass} text-muted-foreground`} aria-disabled="true">›</span>
  )}
</nav>
