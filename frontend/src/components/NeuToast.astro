---
// Toast notification container. Renders messages with auto-dismiss after 5s.
// Fixed position bottom-right. Inline script handles auto-dismiss.
export interface Props {
  message?: string;
  variant?: 'success' | 'error' | 'warning' | 'info';
}

const { message = '', variant = 'info' } = Astro.props;
---

<div id="neu-toast-container" class="neu-toast-container" aria-live="polite" aria-atomic="true">
  {message && (
    <div class={`neu-toast ${variant}`} data-variant={variant}>
      <span>{message}</span>
    </div>
  )}
</div>

<script>
  function autoDismissToasts() {
    const toasts = document.querySelectorAll<HTMLElement>('#neu-toast-container .neu-toast');
    toasts.forEach((toast) => {
      if (toast.dataset.dismissScheduled) return;
      toast.dataset.dismissScheduled = '1';
      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(8px)';
        toast.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
        setTimeout(() => toast.remove(), 250);
      }, 5000);
    });
  }

  // Expose a helper to add toasts dynamically.
  (window as any).neuToast = function (message: string, variant: 'success' | 'error' | 'warning' | 'info' = 'info') {
    const container = document.getElementById('neu-toast-container');
    if (!container) return;
    const el = document.createElement('div');
    el.className = `neu-toast ${variant}`;
    el.dataset.variant = variant;
    const span = document.createElement('span');
    span.textContent = message;
    el.appendChild(span);
    container.appendChild(el);
    autoDismissToasts();
  };

  autoDismissToasts();
</script>
