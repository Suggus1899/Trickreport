---
export interface Props {
  type?: 'button' | 'submit' | 'reset';
  variant?: 'raised' | 'sunken' | 'accent' | 'danger';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  class?: string;
  disabled?: boolean;
}

const { type = 'button', variant = 'raised', size = 'md', href, class: className = '', disabled } = Astro.props;

const base = 'neu-transition inline-flex items-center justify-center font-semibold select-none';
const sizes = {
  sm: 'px-4 py-2 text-sm rounded-xl',
  md: 'px-6 py-3 text-base rounded-2xl',
  lg: 'px-8 py-4 text-lg rounded-2xl',
};
const variants = {
  raised: 'neu-raised neu-convex text-[var(--text-main)] hover:brightness-105 active:neu-pressed',
  sunken: 'neu-sunken text-[var(--text-main)]',
  accent: 'neu-raised text-white bg-[var(--accent)] shadow-[9px_9px_16px_#4a3fd0,-9px_-9px_16px_#8e7dff] hover:brightness-105 active:shadow-[inset_6px_6px_10px_#4a3fd0,inset_-6px_-6px_10px_#8e7dff] active:translate-y-px',
  danger: 'neu-raised text-white bg-[var(--danger)] shadow-[9px_9px_16px_#c43f3f,-9px_-9px_16px_#ff7575] hover:brightness-105 active:shadow-[inset_6px_6px_10px_#c43f3f,inset_-6px_-6px_10px_#ff7575] active:translate-y-px',
};

const classes = `${base} ${sizes[size]} ${variants[variant]} ${className}`;
---

{href ? (
  <a href={href} class={classes} aria-disabled={disabled}>
    <slot />
  </a>
) : (
  <button type={type} class={classes} disabled={disabled}>
    <slot />
  </button>
)}
