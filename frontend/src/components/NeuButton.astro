---
export interface Props {
  type?: 'button' | 'submit' | 'reset';
  variant?: 'raised' | 'sunken' | 'accent' | 'danger';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  class?: string;
  disabled?: boolean;
}

const { type = 'button', variant = 'raised', size = 'md', href, class: className = '', disabled } = Astro.props;

const base = 'neu-transition inline-flex items-center justify-center font-semibold select-none';
const sizes = {
  sm: 'px-4 py-2 text-sm rounded-xl',
  md: 'px-6 py-3 rounded-2xl',
  lg: 'px-8 py-4 text-lg rounded-2xl',
};
const variants = {
  raised: 'neu-raised neu-convex text-main hover:brightness-105 active:neu-pressed',
  sunken: 'neu-sunken text-main',
  accent: 'neu-raised text-white bg-accent shadow-accent hover:brightness-105 active:shadow-accent-pressed active:translate-y-px',
  danger: 'neu-raised text-white bg-[var(--danger)] shadow-danger hover:brightness-105 active:shadow-danger-pressed active:translate-y-px',
};

const classes = `${base} ${sizes[size]} ${variants[variant]} ${className}`;
---

{href ? (
  <a href={href} class={classes} aria-disabled={disabled}>
    <slot />
  </a>
) : (
  <button type={type} class={classes} disabled={disabled}>
    <slot />
  </button>
)}
