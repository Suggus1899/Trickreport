---
// Neu-styled CSS spinner for loading indicators.
export interface Props {
  size?: string;
  class?: string;
}

const { size = '1.25rem', class: className = '' } = Astro.props;
---

<span
  class={`neu-spinner ${className}`}
  style={`width:${size};height:${size};`}
  role="status"
  aria-label="Loading"
></span>
