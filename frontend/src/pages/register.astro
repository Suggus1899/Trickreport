---
import Layout from '../layouts/Layout.astro';
import { RegisterForm } from '../components/auth/RegisterForm';

if (Astro.cookies.has('trickreport_token')) {
  return Astro.redirect('/dashboard');
}
---

<Layout title="Register">
  <div class="min-h-screen flex flex-col items-center justify-center gap-8 p-4">
    <div class="flex flex-col items-center gap-3">
      <div class="w-16 h-16 rounded-2xl bg-primary/10 flex items-center justify-center">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
        </svg>
      </div>
      <h1 class="text-3xl font-bold tracking-tight">Create account</h1>
      <p class="text-sm text-muted-foreground">Join your workspace in seconds</p>
    </div>

    <div class="w-full max-w-md rounded-xl border bg-card text-card-foreground shadow-sm p-8">
      <RegisterForm client:load />

      <div class="flex items-center gap-4 my-6">
        <div class="flex-1 h-px bg-border"></div>
        <span class="text-xs uppercase tracking-wide text-muted-foreground">or</span>
        <div class="flex-1 h-px bg-border"></div>
      </div>

      <p class="text-center text-sm text-muted-foreground">
        Already have an account?
        <a href="/login" class="font-semibold text-primary hover:underline">Sign in</a>
      </p>
    </div>
  </div>
</Layout>
