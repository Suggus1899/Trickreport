---
import Layout from '../layouts/Layout.astro';
import NeuCard from '../components/NeuCard.astro';
import NeuInput from '../components/NeuInput.astro';
import NeuButton from '../components/NeuButton.astro';
import { register } from '../lib/api';

let error = '';

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const name = data.get('name')?.toString() || '';
  const email = data.get('email')?.toString() || '';
  const password = data.get('password')?.toString() || '';
  const confirm = data.get('confirm_password')?.toString() || '';

  if (password !== confirm) {
    error = 'Passwords do not match';
  } else if (password.length < 6) {
    error = 'Password must be at least 6 characters';
  } else {
    try {
      const result = await register({ name, email, password });
      Astro.cookies.set('trickreport_token', result.token, {
        httpOnly: true,
        path: '/',
        maxAge: 60 * 60 * 8,
        sameSite: 'strict',
        secure: import.meta.env.PROD,
      });
      return Astro.redirect('/dashboard');
    } catch (err) {
      error = err instanceof Error ? err.message : 'Registration failed';
    }
  }
}

if (Astro.cookies.has('trickreport_token')) {
  return Astro.redirect('/dashboard');
}
---

<Layout title="Register">
  <div class="auth-page">
    <div class="auth-brand">
      <div class="auth-logo neu-raised">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
        </svg>
      </div>
      <h1 class="auth-title">Create account</h1>
      <p class="auth-subtitle">Join your workspace in seconds</p>
    </div>

    <NeuCard class="auth-card">
      {error && (
        <div class="auth-error" role="alert">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          <span>{error}</span>
        </div>
      )}

      <form method="POST" class="auth-form">
        <NeuInput name="name" type="text" label="Full name" placeholder="Jane Doe" required />
        <NeuInput name="email" type="email" label="Email" placeholder="you@example.com" required />
        <NeuInput
          name="password"
          type="password"
          label="Password"
          placeholder="At least 6 characters"
          required
          showPasswordToggle
          helperText="Minimum 6 characters"
        />
        <NeuInput
          name="confirm_password"
          type="password"
          label="Confirm password"
          placeholder="Re-enter your password"
          required
          showPasswordToggle
        />

        <div class="auth-form-footer">
          <p class="auth-terms">
            By creating an account, you agree to our terms of service.
          </p>
        </div>

        <NeuButton type="submit" variant="accent" size="lg" class="w-full">Create Account</NeuButton>
      </form>

      <div class="auth-divider">
        <span>or</span>
      </div>

      <p class="auth-switch">
        Already have an account?
        <a href="/login" class="auth-link-bold">Sign in</a>
      </p>
    </NeuCard>
  </div>
</Layout>

<style>
  .auth-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    padding: 2rem 1rem;
  }

  .auth-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .auth-logo {
    width: 64px;
    height: 64px;
    border-radius: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .auth-title {
    font-size: 1.875rem;
    font-weight: 700;
    color: var(--text-main);
    margin: 0;
    letter-spacing: -0.025em;
  }

  .auth-subtitle {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0;
  }

  .auth-card {
    width: 100%;
    max-width: 26rem;
  }

  .auth-error {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    padding: 1rem 1.25rem;
    border-radius: 1rem;
    background: rgba(255, 90, 90, 0.08);
    color: var(--danger-dark);
    font-size: 0.875rem;
    box-shadow: var(--shadow-sunken);
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .auth-form-footer {
    margin-top: -0.5rem;
  }

  .auth-terms {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin: 0;
    text-align: center;
  }

  .auth-divider {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 1.75rem 0 1.25rem;
  }

  .auth-divider::before,
  .auth-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--bg-dark);
    opacity: 0.3;
  }

  .auth-divider span {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .auth-switch {
    text-align: center;
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0;
  }

  .auth-link-bold {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
    margin-left: 0.25rem;
    transition: color 0.2s ease;
  }

  .auth-link-bold:hover {
    color: var(--accent-dark);
    text-decoration: underline;
  }
</style>
