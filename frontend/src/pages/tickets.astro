---
import Layout from '../layouts/Layout.astro';
import { Badge, statusBadgeVariant, priorityBadgeVariant } from '../components/ui/badge';
import { Button, buttonVariants } from '../components/ui/button';
import { TicketFilters } from '../components/tickets/TicketFilters';
import { getTickets } from '../lib/api';
import { TicketX } from 'lucide-react';

const token = Astro.locals.token;
if (!token) {
  return Astro.redirect('/login');
}

// Read filter params from URL.
const statusFilter = Astro.url.searchParams.get('status') || '';
const priorityFilter = Astro.url.searchParams.get('priority') || '';
const search = Astro.url.searchParams.get('q') || '';

const user = Astro.locals.user!;
let tickets;
let error = '';

try {
  tickets = await getTickets(token);
} catch (err) {
  error = err instanceof Error ? err.message : 'Failed to load tickets';
}

// Apply filters client-side (API may not support query params yet).
let filteredTickets = tickets || [];
if (statusFilter) {
  filteredTickets = filteredTickets.filter((t) => t.status === statusFilter);
}
if (priorityFilter) {
  filteredTickets = filteredTickets.filter((t) => t.priority === priorityFilter);
}
if (search) {
  const q = search.toLowerCase();
  filteredTickets = filteredTickets.filter(
    (t) => t.title.toLowerCase().includes(q) || (t.description || '').toLowerCase().includes(q),
  );
}

const hasFilters = statusFilter || priorityFilter || search;
const ticketsJson = JSON.stringify(filteredTickets || []);
---

<Layout title="Tickets" user={user ? { name: user.name, role: user.role } : undefined}>
  <div class="max-w-6xl mx-auto" data-tickets={ticketsJson}>
    <div class="flex items-center justify-between mb-8 flex-wrap gap-3">
      <div>
        <h1 class="font-heading text-3xl font-bold">Tickets</h1>
        <p class="text-muted-foreground">Manage support requests</p>
      </div>
      <div class="flex items-center gap-3">
        <Button id="export-csv" variant="outline">Export CSV</Button>
        <a href="/tickets/new" class={buttonVariants({ size: 'default' })}>New Ticket</a>
      </div>
    </div>

    {error && (
      <div class="rounded-xl border border-destructive/30 bg-destructive/5 p-4 text-sm text-destructive mb-6">{error}</div>
    )}

    <div class="rounded-xl border bg-card p-5 mb-6">
      <TicketFilters
        client:load
        initialSearch={search}
        initialStatus={statusFilter}
        initialPriority={priorityFilter}
        hasFilters={!!hasFilters}
      />
    </div>

    <div class="rounded-xl border bg-card overflow-hidden">
      <table class="w-full text-left">
        <thead class="bg-muted/50 text-xs uppercase text-muted-foreground">
          <tr>
            <th class="px-6 py-3 font-semibold">Title</th>
            <th class="px-6 py-3 font-semibold">Status</th>
            <th class="px-6 py-3 font-semibold">Priority</th>
            <th class="px-6 py-3 font-semibold">Created</th>
          </tr>
        </thead>
        <tbody class="divide-y">
          {filteredTickets.length > 0 ? filteredTickets.map((ticket, i) => (
            <tr
              class={`hover:bg-muted/30 transition-colors animate-in fade-in-0 slide-in-from-bottom-1 fill-mode-backwards ${ticket.sla_breached ? 'border-l-2 border-destructive' : ''}`}
              style={{ animationDelay: `${Math.min(i, 12) * 25}ms`, animationDuration: '200ms' }}
            >
              <td class="px-6 py-4">
                <a href={`/tickets/${ticket.id}`} class="font-semibold hover:text-primary transition-colors">
                  {ticket.title}
                </a>
                <p class="text-xs text-muted-foreground">{ticket.creator_name || ticket.created_by}</p>
              </td>
              <td class="px-6 py-4">
                <Badge variant={statusBadgeVariant(ticket.status)} dot>{ticket.status.replace('_', ' ')}</Badge>
              </td>
              <td class="px-6 py-4">
                <Badge variant={priorityBadgeVariant(ticket.priority)} dot>{ticket.priority}</Badge>
              </td>
              <td class="px-6 py-4 text-sm text-muted-foreground font-mono">
                {new Date(ticket.created_at).toLocaleDateString()}
              </td>
            </tr>
          )) : (
            <tr>
              <td colspan="4" class="px-6 py-16 text-center text-muted-foreground">
                <TicketX className="size-8 mx-auto mb-3 opacity-40" />
                <p>{hasFilters ? 'No tickets match your filters.' : 'No tickets yet.'}</p>
                {!hasFilters && (
                  <a href="/tickets/new" class="text-primary font-semibold hover:underline mt-1 inline-block">
                    Create your first ticket
                  </a>
                )}
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  </div>

  <script>
    import { exportToCSV } from '../lib/export';
    import { toast } from '../lib/toast';
    import type { Ticket } from '../lib/api';
    function setupExport() {
      const btn = document.getElementById('export-csv');
      if (!btn) return;
      btn.onclick = () => {
        const container = document.querySelector<HTMLElement>('[data-tickets]');
        const tickets: Ticket[] = JSON.parse(container?.dataset.tickets || '[]');
        if (!tickets.length) {
          toast('No tickets to export.', 'info');
          return;
        }
        const rows = tickets.map((t) => ({
          id: t.id,
          title: t.title,
          status: t.status,
          priority: t.priority,
          category: t.category,
          created_by: t.creator_name || t.created_by,
          assigned_to: t.assignee_name || t.assigned_to || '',
          sla_breached: t.sla_breached,
          created_at: t.created_at,
          updated_at: t.updated_at,
        }));
        exportToCSV(rows, `tickets-${new Date().toISOString().slice(0, 10)}.csv`);
      };
    }
    setupExport();
    document.addEventListener('astro:page-load', setupExport);
  </script>
</Layout>
