---
import Layout from '../../layouts/Layout.astro';
import { buttonVariants } from '../../components/ui/button';
import { Badge, priorityBadgeVariant } from '../../components/ui/badge';
import { getMe, getSLAPolicies, upsertSLAPolicy } from '../../lib/api';
import type { SLAPolicy } from '../../lib/api';

const token = Astro.cookies.get('trickreport_token')?.value;
if (!token) {
  return Astro.redirect('/login');
}

let user;
let policies: SLAPolicy[] = [];
let error = '';

try {
  user = await getMe(token);
} catch {
  return Astro.redirect('/login');
}

if (user.role !== 'admin') {
  return Astro.redirect('/dashboard');
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const priority = form.get('priority')?.toString() || '';
  const response_time_minutes = Number(form.get('response_time_minutes') || 0);
  const resolution_time_minutes = Number(form.get('resolution_time_minutes') || 0);
  const escalation_minutes = Number(form.get('escalation_minutes') || 0);
  try {
    await upsertSLAPolicy(priority, {
      response_time_minutes,
      resolution_time_minutes,
      escalation_minutes,
    }, token);
    return Astro.redirect(`/admin/sla?saved=${priority}`);
  } catch (e: any) {
    error = e?.message || 'Failed to update SLA policy';
  }
}

try {
  policies = await getSLAPolicies(token);
} catch (err) {
  error = err instanceof Error ? err.message : 'Failed to load SLA policies';
}

const saved = Astro.url.searchParams.get('saved');
const inputClass = 'h-9 rounded-md border bg-background px-3 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring';
---

<Layout title="SLA Policies — Admin" user={user ? { name: user.name, role: user.role } : undefined}>
  <div class="max-w-6xl mx-auto">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="font-heading text-3xl font-bold">SLA Policies</h1>
        <p class="text-muted-foreground">Response and resolution targets per priority</p>
      </div>
      <a href="/admin" class={buttonVariants({ variant: 'outline', size: 'sm' })}>Back to Admin</a>
    </div>

    {error && (
      <div class="rounded-xl border border-destructive/30 bg-destructive/5 p-4 text-sm text-destructive mb-6">{error}</div>
    )}

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {policies.length > 0 ? policies.map((policy) => (
        <div class={`rounded-xl border bg-card p-5 transition-colors ${saved === policy.priority ? 'border-success/40' : ''}`}>
          <div class="flex items-center justify-between mb-4">
            <h2 class="font-heading text-lg font-semibold capitalize">{policy.priority}</h2>
            <Badge variant={priorityBadgeVariant(policy.priority)} dot>{policy.priority}</Badge>
          </div>
          <form method="POST" class="flex flex-col gap-4">
            <input type="hidden" name="priority" value={policy.priority} />
            <div class="flex flex-col gap-2">
              <label class="text-sm font-semibold ml-1">Response time (minutes)</label>
              <input name="response_time_minutes" type="number" min="0" value={policy.response_time_minutes} required class={inputClass} />
            </div>
            <div class="flex flex-col gap-2">
              <label class="text-sm font-semibold ml-1">Resolution time (minutes)</label>
              <input name="resolution_time_minutes" type="number" min="0" value={policy.resolution_time_minutes} required class={inputClass} />
            </div>
            <div class="flex flex-col gap-2">
              <label class="text-sm font-semibold ml-1">Escalation (minutes)</label>
              <input name="escalation_minutes" type="number" min="0" value={policy.escalation_minutes} required class={inputClass} />
            </div>
            <div class="flex justify-end pt-2">
              <button type="submit" class={buttonVariants({})}>Save</button>
            </div>
          </form>
        </div>
      )) : (
        <div class="md:col-span-2 rounded-xl border bg-card p-8 text-center text-muted-foreground">
          No SLA policies configured yet.
        </div>
      )}
    </div>
  </div>

  {saved && (
    <script is:inline define:vars={{ saved }}>
      (function () {
        if (window.__toast) window.__toast(saved + ' SLA policy saved', 'success');
        const url = new URL(window.location.href);
        url.searchParams.delete('saved');
        window.history.replaceState({}, '', url);
      })();
    </script>
  )}
</Layout>
