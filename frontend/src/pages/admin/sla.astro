---
import Layout from '../../layouts/Layout.astro';
import NeuCard from '../../components/NeuCard.astro';
import NeuInput from '../../components/NeuInput.astro';
import NeuButton from '../../components/NeuButton.astro';
import NeuBadge from '../../components/NeuBadge.astro';
import { getMe, getSLAPolicies, upsertSLAPolicy } from '../../lib/api';
import type { SLAPolicy } from '../../lib/api';

const token = Astro.cookies.get('trickreport_token')?.value;
if (!token) {
  return Astro.redirect('/login');
}

let user;
let policies: SLAPolicy[] = [];
let error = '';

try {
  user = await getMe(token);
} catch (err) {
  return Astro.redirect('/login');
}

if (user.role !== 'admin') {
  return Astro.redirect('/dashboard');
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const priority = form.get('priority')?.toString() || '';
  const response_time_minutes = Number(form.get('response_time_minutes') || 0);
  const resolution_time_minutes = Number(form.get('resolution_time_minutes') || 0);
  const escalation_minutes = Number(form.get('escalation_minutes') || 0);
  try {
    await upsertSLAPolicy(token, priority, {
      response_time_minutes,
      resolution_time_minutes,
      escalation_minutes,
    });
    return Astro.redirect('/admin/sla');
  } catch (e: any) {
    error = e?.message || 'Failed to update SLA policy';
  }
}

try {
  policies = await getSLAPolicies(token);
} catch (err) {
  error = err instanceof Error ? err.message : 'Failed to load SLA policies';
}

const priorityVariant: Record<string, 'default' | 'success' | 'warning' | 'danger' | 'info'> = {
  low: 'default',
  medium: 'info',
  high: 'warning',
  critical: 'danger',
};
---

<Layout title="SLA Policies — Admin" user={user ? { name: user.name, role: user.role } : undefined}>
  <div class="max-w-6xl mx-auto">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-3xl font-bold">SLA Policies</h1>
        <p class="text-muted">Response and resolution targets per priority</p>
      </div>
      <NeuButton href="/admin" variant="raised" size="sm">Back to Admin</NeuButton>
    </div>

    {error && (
      <NeuCard variant="sunken" class="mb-6 text-rose-700">{error}</NeuCard>
    )}

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {policies.length > 0 ? policies.map((policy) => (
        <NeuCard>
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-semibold capitalize">{policy.priority}</h2>
            <NeuBadge variant={priorityVariant[policy.priority] || 'default'}>{policy.priority}</NeuBadge>
          </div>
          <form method="POST" class="flex flex-col gap-4">
            <input type="hidden" name="priority" value={policy.priority} />
            <NeuInput label="Response time (minutes)" name="response_time_minutes" type="text" value={String(policy.response_time_minutes)} required />
            <NeuInput label="Resolution time (minutes)" name="resolution_time_minutes" type="text" value={String(policy.resolution_time_minutes)} required />
            <NeuInput label="Escalation (minutes)" name="escalation_minutes" type="text" value={String(policy.escalation_minutes)} required />
            <div class="flex justify-end pt-2">
              <NeuButton type="submit" variant="accent" size="md">Save</NeuButton>
            </div>
          </form>
        </NeuCard>
      )) : (
        <NeuCard class="md:col-span-2 text-center text-muted">
          No SLA policies configured yet.
        </NeuCard>
      )}
    </div>
  </div>
</Layout>
