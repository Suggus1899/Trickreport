---
import Layout from '../../layouts/Layout.astro';
import { buttonVariants } from '../../components/ui/button';
import { UsersManager } from '../../components/admin/UsersManager';
import { getMe, getUsers } from '../../lib/api';

const token = Astro.cookies.get('trickreport_token')?.value;
if (!token) {
  return Astro.redirect('/login');
}

let user;
let users;
let error = '';

try {
  user = await getMe(token);
} catch {
  return Astro.redirect('/login');
}

if (user.role !== 'admin') {
  return Astro.redirect('/dashboard');
}

try {
  users = await getUsers(token);
} catch (err) {
  error = err instanceof Error ? err.message : 'Failed to load users';
}
---

<Layout title="Users — Admin" user={{ name: user.name, role: user.role }}>
  <div class="max-w-6xl mx-auto">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="font-heading text-3xl font-bold">Users</h1>
        <p class="text-muted-foreground">Manage workspace members</p>
      </div>
      <a href="/admin" class={buttonVariants({ variant: 'outline', size: 'sm' })}>Back to Admin</a>
    </div>

    {error && (
      <div class="rounded-xl border border-destructive/30 bg-destructive/5 p-4 text-sm text-destructive mb-6">{error}</div>
    )}

    <UsersManager client:load initialUsers={users || []} />
  </div>
</Layout>
