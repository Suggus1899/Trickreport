---
import Layout from '../../layouts/Layout.astro';
import NeuCard from '../../components/NeuCard.astro';
import NeuButton from '../../components/NeuButton.astro';
import NeuBadge from '../../components/NeuBadge.astro';
import { getMe, getAnalyticsVolume, getAnalyticsStatus, getAnalyticsResolution, API_URL } from '../../lib/api';
import type { VolumePoint, StatusDistribution, ResolutionMetrics } from '../../lib/api';

const token = Astro.cookies.get('trickreport_token')?.value;
if (!token) {
  return Astro.redirect('/login');
}

let user;
let volume: VolumePoint[] = [];
let statusDist: StatusDistribution[] = [];
let resolution: ResolutionMetrics[] = [];
let error = '';

try {
  user = await getMe(token);
} catch (err) {
  return Astro.redirect('/login');
}

if (user.role !== 'admin') {
  return Astro.redirect('/dashboard');
}

try {
  [volume, statusDist, resolution] = await Promise.all([
    getAnalyticsVolume(token),
    getAnalyticsStatus(token),
    getAnalyticsResolution(token),
  ]);
} catch (err) {
  error = err instanceof Error ? err.message : 'Failed to load analytics';
}

const statusVariant: Record<string, 'default' | 'success' | 'warning' | 'danger' | 'info'> = {
  open: 'default',
  in_progress: 'warning',
  waiting_client: 'info',
  resolved: 'success',
  closed: 'default',
};

const priorityVariant: Record<string, 'default' | 'success' | 'warning' | 'danger' | 'info'> = {
  low: 'default',
  medium: 'info',
  high: 'warning',
  critical: 'danger',
};

// Chart palette for status slices / line series.
const CHART_COLORS = ['#6d5dfc', '#4cd964', '#ffcc00', '#ff5a5a', '#34a853', '#8b7dff'];

// Pre-serialize initial data so the client script can render charts immediately.
const initialData = JSON.stringify({ volume, status: statusDist, resolution });
---

<Layout title="Analytics — Admin" user={user ? { name: user.name, role: user.role } : undefined}>
  <div class="max-w-6xl mx-auto">
    <div class="flex items-center justify-between mb-8 flex-wrap gap-4">
      <div>
        <h1 class="text-3xl font-bold">Analytics</h1>
        <p class="text-muted">Volume, status and resolution insights</p>
      </div>
      <div class="flex items-center gap-3 flex-wrap">
        <div class="flex items-center gap-2">
          <label for="range" class="text-sm font-semibold text-main ml-1">Range</label>
          <select id="range" class="analytics-range">
            <option value="7d">Last 7 days</option>
            <option value="30d" selected>Last 30 days</option>
            <option value="90d">Last 90 days</option>
            <option value="custom">Custom</option>
          </select>
        </div>
        <div id="custom-range" class="flex items-center gap-2" style="display:none;">
          <input id="from" type="date" class="analytics-date" />
          <span class="text-muted">→</span>
          <input id="to" type="date" class="analytics-date" />
        </div>
        <NeuButton id="export-csv" variant="raised" size="sm">Export CSV</NeuButton>
        <NeuButton href="/admin" variant="raised" size="sm">Back to Admin</NeuButton>
      </div>
    </div>

    {error && (
      <NeuCard variant="sunken" class="mb-6 text-rose-700">{error}</NeuCard>
    )}

    <div id="analytics-status" class="mb-6 text-sm text-muted" style="display:none;"></div>

    <div class="flex flex-col gap-6">
      <NeuCard>
        <h2 class="text-xl font-semibold mb-4">Ticket volume (trend)</h2>
        <div id="line-chart" class="line-chart-wrap"></div>
      </NeuCard>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <NeuCard>
          <h2 class="text-xl font-semibold mb-4">Status distribution</h2>
          <div class="flex flex-col gap-4 md:flex-row md:items-center">
            <div id="pie-chart" class="pie-chart-wrap"></div>
            <div id="pie-legend" class="pie-legend flex flex-col gap-2 flex-1"></div>
          </div>
        </NeuCard>

        <NeuCard class="overflow-hidden p-0">
          <div class="p-6 pb-0">
            <h2 class="text-xl font-semibold mb-4">Resolution time by priority</h2>
          </div>
          <table class="w-full text-left">
            <thead class="neu-sunken text-xs uppercase text-muted">
              <tr>
                <th class="px-6 py-4 font-semibold">Priority</th>
                <th class="px-6 py-4 font-semibold">Avg hours</th>
              </tr>
            </thead>
            <tbody class="divide-y" id="resolution-body">
              {resolution.length > 0 ? resolution.map((r) => (
                <tr class="hover:bg-white/30 transition-colors">
                  <td class="px-6 py-4">
                    <NeuBadge variant={priorityVariant[r.priority] || 'default'}>{r.priority}</NeuBadge>
                  </td>
                  <td class="px-6 py-4 font-semibold text-main">{r.avg_hours.toFixed(1)}h</td>
                </tr>
              )) : (
                <tr>
                  <td colspan="2" class="px-6 py-12 text-center text-muted">No data available.</td>
                </tr>
              )}
            </tbody>
          </table>
        </NeuCard>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ token, API_URL, CHART_COLORS, initialData }}>
    (function () {
      const statusEl = document.getElementById('analytics-status');
      const rangeSelect = document.getElementById('range');
      const customRange = document.getElementById('custom-range');
      const fromInput = document.getElementById('from');
      const toInput = document.getElementById('to');
      const lineWrap = document.getElementById('line-chart');
      const pieWrap = document.getElementById('pie-chart');
      const pieLegend = document.getElementById('pie-legend');
      const resolutionBody = document.getElementById('resolution-body');
      const exportBtn = document.getElementById('export-csv');

      let current = JSON.parse(initialData);

      function showStatus(msg, isError) {
        if (!statusEl) return;
        statusEl.style.display = msg ? 'block' : 'none';
        statusEl.textContent = msg || '';
        statusEl.className = 'mb-6 text-sm ' + (isError ? 'text-rose-700' : 'text-muted');
      }

      // ─── SVG line chart ──────────────────────────────────────────────
      function renderLineChart(volume) {
        if (!lineWrap) return;
        if (!volume || !volume.length) {
          lineWrap.innerHTML = '<p class="text-muted text-center py-6">No volume data available.</p>';
          return;
        }
        const W = 720, H = 260, PAD = 40;
        const max = Math.max(...volume.map((v) => v.count), 1);
        const stepX = volume.length > 1 ? (W - PAD * 2) / (volume.length - 1) : 0;
        const pts = volume.map((v, i) => {
          const x = PAD + i * stepX;
          const y = H - PAD - (v.count / max) * (H - PAD * 2);
          return { x, y, v };
        });
        const pathD = pts.map((p, i) => (i === 0 ? 'M' : 'L') + p.x.toFixed(1) + ' ' + p.y.toFixed(1)).join(' ');
        const areaD = pathD + ` L${pts[pts.length - 1].x.toFixed(1)} ${H - PAD} L${pts[0].x.toFixed(1)} ${H - PAD} Z`;
        const gridLines = [0, 0.25, 0.5, 0.75, 1].map((t) => {
          const y = H - PAD - t * (H - PAD * 2);
          return `<line x1="${PAD}" y1="${y}" x2="${W - PAD}" y2="${y}" stroke="rgba(163,177,198,0.25)" stroke-width="1"/>` +
            `<text x="${PAD - 8}" y="${y + 4}" text-anchor="end" font-size="10" fill="#7d8da8">${Math.round(t * max)}</text>`;
        }).join('');
        const dots = pts.map((p, i) =>
          `<g class="line-dot" data-i="${i}">
            <circle cx="${p.x}" cy="${p.y}" r="4" fill="#6d5dfc" stroke="#fff" stroke-width="2"/>
            <title>${new Date(p.v.date).toLocaleDateString()}: ${p.v.count} tickets</title>
          </g>`
        ).join('');
        const xLabels = pts.map((p, i) => {
          if (volume.length > 12 && i % Math.ceil(volume.length / 8) !== 0) return '';
          return `<text x="${p.x}" y="${H - PAD + 18}" text-anchor="middle" font-size="10" fill="#7d8da8">${new Date(p.v.date).toLocaleDateString(undefined, { month: 'short', day: 'numeric' })}</text>`;
        }).join('');

        lineWrap.innerHTML = `<svg viewBox="0 0 ${W} ${H}" class="line-svg" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Ticket volume over time">
          <defs><linearGradient id="lineFill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#6d5dfc" stop-opacity="0.35"/>
            <stop offset="100%" stop-color="#6d5dfc" stop-opacity="0.02"/>
          </linearGradient></defs>
          ${gridLines}
          <path d="${areaD}" fill="url(#lineFill)"/>
          <path d="${pathD}" fill="none" stroke="#6d5dfc" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/>
          ${xLabels}
          ${dots}
        </svg>`;

        // Interactive tooltips on hover.
        const tooltip = document.createElement('div');
        tooltip.className = 'chart-tooltip';
        tooltip.style.display = 'none';
        lineWrap.appendChild(tooltip);
        lineWrap.querySelectorAll('.line-dot').forEach((g) => {
          g.addEventListener('mouseenter', () => {
            const i = Number(g.getAttribute('data-i'));
            const p = pts[i];
            tooltip.innerHTML = `<strong>${new Date(p.v.date).toLocaleDateString()}</strong><br/>${p.v.count} tickets`;
            tooltip.style.display = 'block';
            const rect = lineWrap.getBoundingClientRect();
            const svg = lineWrap.querySelector('svg');
            const svgRect = svg.getBoundingClientRect();
            const scaleX = svgRect.width / W;
            const scaleY = svgRect.height / H;
            tooltip.style.left = (p.x * scaleX) + 'px';
            tooltip.style.top = (p.y * scaleY - 10) + 'px';
          });
          g.addEventListener('mouseleave', () => { tooltip.style.display = 'none'; });
        });
      }

      // ─── SVG pie/donut chart ─────────────────────────────────────────
      function renderPieChart(status) {
        if (!pieWrap || !pieLegend) return;
        if (!status || !status.length) {
          pieWrap.innerHTML = '<p class="text-muted text-center py-6">No data available.</p>';
          pieLegend.innerHTML = '';
          return;
        }
        const total = status.reduce((s, x) => s + x.count, 0) || 1;
        const R = 80, r = 48, cx = 100, cy = 100;
        let start = -Math.PI / 2;
        const slices = status.map((s, i) => {
          const frac = s.count / total;
          const end = start + frac * Math.PI * 2;
          const large = frac > 0.5 ? 1 : 0;
          const x1 = cx + R * Math.cos(start), y1 = cy + R * Math.sin(start);
          const x2 = cx + R * Math.cos(end), y2 = cy + R * Math.sin(end);
          const xi1 = cx + r * Math.cos(end), yi1 = cy + r * Math.sin(end);
          const xi2 = cx + r * Math.cos(start), yi2 = cy + r * Math.sin(start);
          const d = `M${x1} ${y1} A${R} ${R} 0 ${large} 1 ${x2} ${y2} L${xi1} ${yi1} A${r} ${r} 0 ${large} 0 ${xi2} ${yi2} Z`;
          const color = CHART_COLORS[i % CHART_COLORS.length];
          const mid = (start + end) / 2;
          const labelX = cx + (R + 14) * Math.cos(mid);
          const labelY = cy + (R + 14) * Math.sin(mid);
          start = end;
          return { d, color, s, pct: (frac * 100).toFixed(1), labelX, labelY };
        });

        pieWrap.innerHTML = `<svg viewBox="0 0 200 200" class="pie-svg" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Status distribution">
          ${slices.map((sl) => `<path d="${sl.d}" fill="${sl.color}" stroke="#e0e5ec" stroke-width="1" class="pie-slice" data-label="${sl.s.status}" data-count="${sl.s.count}" data-pct="${sl.pct}"><title>${sl.s.status}: ${sl.s.count} (${sl.pct}%)</title></path>`).join('')}
          <text x="100" y="96" text-anchor="middle" font-size="22" font-weight="700" fill="#4d5f7a">${total}</text>
          <text x="100" y="114" text-anchor="middle" font-size="10" fill="#7d8da8">tickets</text>
        </svg>`;

        pieLegend.innerHTML = slices.map((sl) =>
          `<div class="legend-item flex items-center gap-2" data-label="${sl.s.status}">
            <span class="legend-swatch" style="background:${sl.color}"></span>
            <span class="text-sm font-semibold text-main capitalize">${sl.s.status.replace('_', ' ')}</span>
            <span class="text-xs text-muted">${sl.s.count} · ${sl.pct}%</span>
          </div>`
        ).join('');

        // Tooltip on slice hover.
        const tooltip = document.createElement('div');
        tooltip.className = 'chart-tooltip';
        tooltip.style.display = 'none';
        pieWrap.appendChild(tooltip);
        pieWrap.querySelectorAll('.pie-slice').forEach((path) => {
          path.addEventListener('mouseenter', () => {
            tooltip.innerHTML = `<strong>${path.getAttribute('data-label')}</strong><br/>${path.getAttribute('data-count')} tickets (${path.getAttribute('data-pct')}%)`;
            tooltip.style.display = 'block';
            tooltip.style.left = '50%';
            tooltip.style.top = '10px';
            tooltip.style.transform = 'translateX(-50%)';
          });
          path.addEventListener('mouseleave', () => { tooltip.style.display = 'none'; });
        });
      }

      function renderResolution(resolution) {
        if (!resolutionBody) return;
        if (!resolution || !resolution.length) {
          resolutionBody.innerHTML = '<tr><td colspan="2" class="px-6 py-12 text-center text-muted">No data available.</td></tr>';
          return;
        }
        resolutionBody.innerHTML = resolution.map((r) => {
          const variant = ({ low: 'default', medium: 'info', high: 'warning', critical: 'danger' })[r.priority] || 'default';
          return `<tr class="hover:bg-white/30 transition-colors">
            <td class="px-6 py-4"><span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold neu-convex text-main">${r.priority}</span></td>
            <td class="px-6 py-4 font-semibold text-main">${r.avg_hours.toFixed(1)}h</td>
          </tr>`;
        }).join('');
      }

      function renderAll(data) {
        current = data;
        renderLineChart(data.volume);
        renderPieChart(data.status);
        renderResolution(data.resolution);
      }

      // Initial render from server-provided data.
      renderAll(current);

      // ─── Date range filter ───────────────────────────────────────────
      async function fetchCharts() {
        const range = rangeSelect.value;
        let url = `${API_URL}/api/v1/admin/analytics/charts?range=${encodeURIComponent(range)}`;
        if (range === 'custom') {
          if (!fromInput.value || !toInput.value) {
            showStatus('Please pick a start and end date.', true);
            return;
          }
          url += `&from=${fromInput.value}&to=${toInput.value}`;
        }
        showStatus('Loading…', false);
        try {
          const res = await fetch(url, {
            headers: {
              'Content-Type': 'application/json',
              'X-Tenant-ID': 'default',
              Authorization: `Bearer ${token}`,
            },
            credentials: 'include',
          });
          if (!res.ok) {
            const body = await res.json().catch(() => ({}));
            throw new Error(body.error || `Request failed (${res.status})`);
          }
          const data = await res.json();
          // The charts endpoint may return either the consolidated shape
          // { volume, status, resolution } or a legacy shape — normalise.
          const norm = {
            volume: data.volume || data.volume_data || data.charts?.volume || current.volume,
            status: data.status || data.status_distribution || data.charts?.status || current.status,
            resolution: data.resolution || data.resolution_time || data.charts?.resolution || current.resolution,
          };
          renderAll(norm);
          showStatus('', false);
        } catch (err) {
          showStatus('Failed to load charts: ' + (err && err.message || 'unknown error'), true);
        }
      }

      rangeSelect.addEventListener('change', () => {
        customRange.style.display = rangeSelect.value === 'custom' ? 'flex' : 'none';
        if (rangeSelect.value !== 'custom') fetchCharts();
      });
      fromInput.addEventListener('change', () => { if (toInput.value) fetchCharts(); });
      toInput.addEventListener('change', () => { if (fromInput.value) fetchCharts(); });

      // ─── CSV export ──────────────────────────────────────────────────
      exportBtn.addEventListener('click', () => {
        const rows = [];
        (current.volume || []).forEach((v) => rows.push({ section: 'volume', date: v.date, count: v.count }));
        (current.status || []).forEach((s) => rows.push({ section: 'status', status: s.status, count: s.count }));
        (current.resolution || []).forEach((r) => rows.push({ section: 'resolution', priority: r.priority, avg_hours: r.avg_hours }));
        if (!rows.length) { showStatus('Nothing to export.', true); return; }
        const headers = ['section', 'date', 'count', 'status', 'priority', 'avg_hours'];
        const lines = [headers.join(',')];
        rows.forEach((row) => {
          lines.push(headers.map((h) => {
            const val = row[h];
            if (val === undefined || val === null) return '';
            const s = String(val);
            return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
          }).join(','));
        });
        const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `analytics-${rangeSelect.value}-${new Date().toISOString().slice(0, 10)}.csv`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });
    })();
  </script>
</Layout>
