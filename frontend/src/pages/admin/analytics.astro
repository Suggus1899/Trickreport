---
import Layout from '../../layouts/Layout.astro';
import NeuCard from '../../components/NeuCard.astro';
import NeuButton from '../../components/NeuButton.astro';
import { getMe, getAnalyticsVolume, getAnalyticsStatus, getAnalyticsResolution } from '../../lib/api';
import type { VolumePoint, StatusDistribution, ResolutionMetrics } from '../../lib/api';

const token = Astro.cookies.get('trickreport_token')?.value;
if (!token) {
  return Astro.redirect('/login');
}

let user;
let volume: VolumePoint[] = [];
let statusDist: StatusDistribution[] = [];
let resolution: ResolutionMetrics[] = [];
let error = '';

try {
  user = await getMe(token);
} catch (err) {
  return Astro.redirect('/login');
}

if (user.role !== 'admin') {
  return Astro.redirect('/dashboard');
}

try {
  [volume, statusDist, resolution] = await Promise.all([
    getAnalyticsVolume(token),
    getAnalyticsStatus(token),
    getAnalyticsResolution(token),
  ]);
} catch (err) {
  error = err instanceof Error ? err.message : 'Failed to load analytics';
}

const maxVolume = volume.length > 0 ? Math.max(...volume.map((v) => v.count), 1) : 1;

const statusVariant: Record<string, 'default' | 'success' | 'warning' | 'danger' | 'info'> = {
  open: 'default',
  in_progress: 'warning',
  waiting_client: 'info',
  resolved: 'success',
  closed: 'default',
};

const priorityVariant: Record<string, 'default' | 'success' | 'warning' | 'danger' | 'info'> = {
  low: 'default',
  medium: 'info',
  high: 'warning',
  critical: 'danger',
};
---

<Layout title="Analytics — Admin" user={user ? { name: user.name, role: user.role } : undefined}>
  <div class="max-w-6xl mx-auto">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-3xl font-bold">Analytics</h1>
        <p class="text-muted">Volume, status and resolution insights</p>
      </div>
      <NeuButton href="/admin" variant="raised" size="sm">Back to Admin</NeuButton>
    </div>

    {error && (
      <NeuCard variant="sunken" class="mb-6 text-rose-700">{error}</NeuCard>
    )}

    <div class="flex flex-col gap-6">
      <NeuCard>
        <h2 class="text-xl font-semibold mb-4">Ticket volume</h2>
        {volume.length > 0 ? (
          <div class="flex flex-col gap-3">
            {volume.map((point) => (
              <div class="flex items-center gap-4">
                <span class="text-sm text-muted w-28 shrink-0">{new Date(point.date).toLocaleDateString()}</span>
                <div class="flex-1 neu-sunken rounded-full overflow-hidden h-6">
                  <div
                    class="h-full bg-accent rounded-full flex items-center justify-end px-3"
                    style={`width: ${Math.max((point.count / maxVolume) * 100, 8)}%`}
                  >
                    <span class="text-xs font-bold text-white">{point.count}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <p class="text-muted text-center py-6">No volume data available.</p>
        )}
      </NeuCard>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <NeuCard class="overflow-hidden p-0">
          <div class="p-6 pb-0">
            <h2 class="text-xl font-semibold mb-4">Status distribution</h2>
          </div>
          <table class="w-full text-left">
            <thead class="neu-sunken text-xs uppercase text-muted">
              <tr>
                <th class="px-6 py-4 font-semibold">Status</th>
                <th class="px-6 py-4 font-semibold">Count</th>
              </tr>
            </thead>
            <tbody class="divide-y">
              {statusDist.length > 0 ? statusDist.map((s) => (
                <tr class="hover:bg-white/30 transition-colors">
                  <td class="px-6 py-4">
                    <NeuBadge variant={statusVariant[s.status] || 'default'}>{s.status.replace('_', ' ')}</NeuBadge>
                  </td>
                  <td class="px-6 py-4 font-semibold text-main">{s.count}</td>
                </tr>
              )) : (
                <tr>
                  <td colspan="2" class="px-6 py-12 text-center text-muted">No data available.</td>
                </tr>
              )}
            </tbody>
          </table>
        </NeuCard>

        <NeuCard class="overflow-hidden p-0">
          <div class="p-6 pb-0">
            <h2 class="text-xl font-semibold mb-4">Resolution time by priority</h2>
          </div>
          <table class="w-full text-left">
            <thead class="neu-sunken text-xs uppercase text-muted">
              <tr>
                <th class="px-6 py-4 font-semibold">Priority</th>
                <th class="px-6 py-4 font-semibold">Avg hours</th>
              </tr>
            </thead>
            <tbody class="divide-y">
              {resolution.length > 0 ? resolution.map((r) => (
                <tr class="hover:bg-white/30 transition-colors">
                  <td class="px-6 py-4">
                    <NeuBadge variant={priorityVariant[r.priority] || 'default'}>{r.priority}</NeuBadge>
                  </td>
                  <td class="px-6 py-4 font-semibold text-main">{r.avg_hours.toFixed(1)}h</td>
                </tr>
              )) : (
                <tr>
                  <td colspan="2" class="px-6 py-12 text-center text-muted">No data available.</td>
                </tr>
              )}
            </tbody>
          </table>
        </NeuCard>
      </div>
    </div>
  </div>
</Layout>
