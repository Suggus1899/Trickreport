---
import Layout from '../../layouts/Layout.astro';
import { buttonVariants } from '../../components/ui/button';
import { AnalyticsCharts } from '../../components/admin/AnalyticsCharts';
import { getMe, getAnalyticsCharts } from '../../lib/api';
import type { VolumePoint, StatusDistribution, ResolutionMetrics } from '../../lib/api';

const token = Astro.cookies.get('trickreport_token')?.value;
if (!token) {
  return Astro.redirect('/login');
}

let user;
let volume: VolumePoint[] = [];
let statusDist: StatusDistribution[] = [];
let resolution: ResolutionMetrics[] = [];
let error = '';

try {
  user = await getMe(token);
} catch {
  return Astro.redirect('/login');
}

if (user.role !== 'admin') {
  return Astro.redirect('/dashboard');
}

try {
  // One request instead of three — /admin/analytics/charts returns every
  // dataset this page needs, plus SLA compliance.
  const charts = await getAnalyticsCharts(token);
  volume = charts.volume;
  statusDist = charts.status_distribution;
  resolution = charts.resolution_time;
} catch (err) {
  error = err instanceof Error ? err.message : 'Failed to load analytics';
}
---

<Layout title="Analytics — Admin" user={{ name: user.name, role: user.role }}>
  <div class="max-w-6xl mx-auto">
    <div class="flex items-center justify-between mb-8 flex-wrap gap-4">
      <div>
        <h1 class="font-heading text-3xl font-bold">Analytics</h1>
        <p class="text-muted-foreground">Volume, status and resolution insights</p>
      </div>
      <a href="/admin" class={buttonVariants({ variant: 'outline', size: 'sm' })}>Back to Admin</a>
    </div>

    {error && (
      <div class="rounded-xl border border-destructive/30 bg-destructive/5 p-4 text-sm text-destructive mb-6">{error}</div>
    )}

    <AnalyticsCharts client:load volume={volume} status={statusDist} resolution={resolution} />
  </div>
</Layout>
