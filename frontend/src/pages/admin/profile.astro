---
import Layout from '../../layouts/Layout.astro';
import { buttonVariants } from '../../components/ui/button';
import { Badge } from '../../components/ui/badge';
import { getMe, getSummary } from '../../lib/api';

const token = Astro.cookies.get('trickreport_token')?.value;
if (!token) return Astro.redirect('/login');

let me;
try {
  me = await getMe(token);
} catch {
  return Astro.redirect('/login');
}

if (me.role !== 'admin') return Astro.redirect('/dashboard');

let summary;
try {
  summary = await getSummary(token);
} catch {
  summary = { total_tickets: 0, open_tickets: 0, resolved_tickets: 0, sla_breached: 0 };
}
---

<Layout title="Admin Profile — Trickreport" user={{ name: me.name, role: me.role }}>
  <div class="max-w-5xl mx-auto py-8">
    <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
      <div>
        <h1 class="text-2xl font-bold">Admin Profile</h1>
        <p class="text-sm text-muted-foreground">System overview and administrative tools</p>
      </div>
      <div class="flex gap-2">
        <a href="/profile" class={buttonVariants({ variant: 'outline', size: 'sm' })}>My Profile</a>
        <a href="/dashboard" class={buttonVariants({ variant: 'outline', size: 'sm' })}>Dashboard</a>
      </div>
    </div>

    <div class="rounded-xl border bg-card p-5 mb-6">
      <div class="flex items-center gap-4 flex-wrap">
        <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center text-2xl font-bold text-primary shrink-0">
          {me.name.charAt(0).toUpperCase()}
        </div>
        <div class="flex-1 min-w-0">
          <h2 class="text-lg font-semibold">{me.name}</h2>
          <p class="text-sm text-muted-foreground">{me.email}</p>
          <div class="flex gap-2 mt-2">
            <Badge variant="destructive">Administrator</Badge>
            <Badge variant="secondary">Full Access</Badge>
          </div>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
      <div class="rounded-xl border bg-card p-5">
        <p class="text-xs text-muted-foreground uppercase tracking-wide">Total Tickets</p>
        <p class="text-3xl font-bold mt-1">{summary.total_tickets || 0}</p>
      </div>
      <div class="rounded-xl border bg-card p-5">
        <p class="text-xs text-muted-foreground uppercase tracking-wide">Open</p>
        <p class="text-3xl font-bold text-primary mt-1">{summary.open_tickets || 0}</p>
      </div>
      <div class="rounded-xl border bg-card p-5">
        <p class="text-xs text-muted-foreground uppercase tracking-wide">Resolved</p>
        <p class="text-3xl font-bold mt-1">{summary.resolved_tickets || 0}</p>
      </div>
      <div class="rounded-xl border bg-card p-5">
        <p class="text-xs text-muted-foreground uppercase tracking-wide">SLA Breached</p>
        <p class="text-3xl font-bold text-destructive mt-1">{summary.sla_breached || 0}</p>
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-6 mb-6">
      <div class="rounded-xl border bg-card p-5">
        <h3 class="text-lg font-semibold mb-4">User Management</h3>
        <div class="flex flex-col gap-3">
          <a href="/admin/users" class="flex items-center justify-between rounded-lg border px-4 py-3 text-sm font-semibold hover:bg-muted">
            <span>Manage Users</span>
            <span>&rarr;</span>
          </a>
          <a href="/admin/users" class="flex items-center justify-between rounded-lg border px-4 py-3 text-sm font-semibold hover:bg-muted">
            <span>Create New User</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>

      <div class="rounded-xl border bg-card p-5">
        <h3 class="text-lg font-semibold mb-4">SLA & Automation</h3>
        <div class="flex flex-col gap-3">
          <a href="/admin/sla" class="flex items-center justify-between rounded-lg border px-4 py-3 text-sm font-semibold hover:bg-muted">
            <span>SLA Policies</span>
            <span>&rarr;</span>
          </a>
          <a href="/admin/automations" class="flex items-center justify-between rounded-lg border px-4 py-3 text-sm font-semibold hover:bg-muted">
            <span>Automation Rules</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      <div class="rounded-xl border bg-card p-5">
        <h3 class="text-lg font-semibold mb-4">Analytics</h3>
        <div class="flex flex-col gap-3">
          <a href="/admin/analytics" class="flex items-center justify-between rounded-lg border px-4 py-3 text-sm font-semibold hover:bg-muted">
            <span>View Analytics</span>
            <span>&rarr;</span>
          </a>
          <a href="/admin/analytics" class="flex items-center justify-between rounded-lg border px-4 py-3 text-sm font-semibold hover:bg-muted">
            <span>Charts & Trends</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>

      <div class="rounded-xl border bg-card p-5">
        <h3 class="text-lg font-semibold mb-4">Account</h3>
        <div class="flex flex-col gap-3">
          <a href="/profile" class="flex items-center justify-between rounded-lg border px-4 py-3 text-sm font-semibold hover:bg-muted">
            <span>Edit My Profile</span>
            <span>&rarr;</span>
          </a>
          <a href="/profile" class="flex items-center justify-between rounded-lg border px-4 py-3 text-sm font-semibold hover:bg-muted">
            <span>Security & MFA</span>
            <span>&rarr;</span>
          </a>
          <a href="/logout" class="flex items-center justify-between rounded-lg border px-4 py-3 text-sm font-semibold text-destructive hover:bg-destructive/5">
            <span>Logout</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
