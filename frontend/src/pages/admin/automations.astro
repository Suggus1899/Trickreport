---
import Layout from '../../layouts/Layout.astro';
import { buttonVariants } from '../../components/ui/button';
import { AutomationsManager } from '../../components/admin/AutomationsManager';
import { getMe, getAutomations } from '../../lib/api';
import type { AutomationRule } from '../../lib/api';

const token = Astro.cookies.get('trickreport_token')?.value;
if (!token) {
  return Astro.redirect('/login');
}

let user;
let automations: AutomationRule[] = [];
let error = '';

try {
  user = await getMe(token);
} catch {
  return Astro.redirect('/login');
}

if (user.role !== 'admin') {
  return Astro.redirect('/dashboard');
}

try {
  automations = await getAutomations(token);
} catch (err) {
  error = err instanceof Error ? err.message : 'Failed to load automations';
}
---

<Layout title="Automations — Admin" user={{ name: user.name, role: user.role }}>
  <div class="max-w-6xl mx-auto">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="font-heading text-3xl font-bold">Automations</h1>
        <p class="text-muted-foreground">Rules that trigger actions automatically</p>
      </div>
      <a href="/admin" class={buttonVariants({ variant: 'outline', size: 'sm' })}>Back to Admin</a>
    </div>

    {error && (
      <div class="rounded-xl border border-destructive/30 bg-destructive/5 p-4 text-sm text-destructive mb-6">{error}</div>
    )}

    <AutomationsManager client:load initialAutomations={automations} />
  </div>
</Layout>
