---
import Layout from '../../layouts/Layout.astro';
import NeuCard from '../../components/NeuCard.astro';
import NeuInput from '../../components/NeuInput.astro';
import NeuButton from '../../components/NeuButton.astro';
import NeuBadge from '../../components/NeuBadge.astro';
import { getMe, getAutomations, createAutomation, API_URL } from '../../lib/api';
import type { AutomationRule } from '../../lib/api';

const token = Astro.cookies.get('trickreport_token')?.value;
if (!token) {
  return Astro.redirect('/login');
}

let user;
let automations: AutomationRule[] = [];
let error = '';

try {
  user = await getMe(token);
} catch (err) {
  return Astro.redirect('/login');
}

if (user.role !== 'admin') {
  return Astro.redirect('/dashboard');
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const name = form.get('name')?.toString() || '';
  const description = form.get('description')?.toString() || '';
  const trigger_type = form.get('trigger_type')?.toString() || '';
  const conditionsRaw = form.get('conditions')?.toString() || '{}';
  const actionsRaw = form.get('actions')?.toString() || '[]';
  const is_active = form.get('is_active')?.toString() === 'on';
  let conditions: Record<string, any> = {};
  let actions: any[] = [];
  try {
    conditions = JSON.parse(conditionsRaw);
    actions = JSON.parse(actionsRaw);
  } catch {
    error = 'Conditions and actions must be valid JSON';
  }
  if (!error) {
    try {
      await createAutomation(token, {
        name, description, trigger_type, conditions, actions, is_active,
      });
      return Astro.redirect('/admin/automations');
    } catch (e: any) {
      error = e?.message || 'Failed to create automation';
    }
  }
}

try {
  automations = await getAutomations(token);
} catch (err) {
  error = err instanceof Error ? err.message : 'Failed to load automations';
}

const triggerTypes = [
  { value: 'ticket_created', label: 'Ticket Created' },
  { value: 'ticket_updated', label: 'Ticket Updated' },
  { value: 'comment_added', label: 'Comment Added' },
  { value: 'sla_breached', label: 'SLA Breached' },
];

const conditionFields = [
  { value: 'status', label: 'Status' },
  { value: 'priority', label: 'Priority' },
  { value: 'category', label: 'Category' },
];

const conditionOperators = [
  { value: 'equals', label: 'equals' },
  { value: 'not_equals', label: 'not equals' },
  { value: 'contains', label: 'contains' },
];

const actionTypes = [
  { value: 'change_status', label: 'Change Status' },
  { value: 'assign', label: 'Assign' },
  { value: 'send_email', label: 'Send Email' },
  { value: 'add_tag', label: 'Add Tag' },
];

const automationsJson = JSON.stringify(automations || []);
---

<Layout title="Automations — Admin" user={user ? { name: user.name, role: user.role } : undefined}>
  <div class="max-w-6xl mx-auto">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-3xl font-bold">Automations</h1>
        <p class="text-muted">Rules that trigger actions automatically</p>
      </div>
      <NeuButton href="/admin" variant="raised" size="sm">Back to Admin</NeuButton>
    </div>

    {error && (
      <NeuCard variant="sunken" class="mb-6 text-rose-700">{error}</NeuCard>
    )}

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <NeuCard class="lg:col-span-1">
        <h2 class="text-lg font-semibold mb-1" id="builder-title">Create automation</h2>
        <p class="text-xs text-muted mb-4" id="builder-subtitle">Build conditions and actions visually.</p>
        <form id="automation-form" method="POST" class="flex flex-col gap-4">
          <input type="hidden" name="edit_id" id="edit_id" value="" />
          <NeuInput label="Name" name="name" type="text" required />
          <NeuInput label="Description" name="description" type="text" />
          <div class="flex flex-col gap-2">
            <label for="trigger_type" class="text-sm font-semibold text-main ml-1">Trigger type</label>
            <select id="trigger_type" name="trigger_type">
              {triggerTypes.map((t) => <option value={t.value}>{t.label}</option>)}
            </select>
          </div>

          <div class="flex flex-col gap-2">
            <label class="text-sm font-semibold text-main ml-1">Conditions</label>
            <div id="conditions-builder" class="flex flex-col gap-2"></div>
            <button type="button" id="add-condition" class="neu-transition px-4 py-2 rounded-xl font-semibold neu-convex text-accent text-sm self-start">+ Add condition</button>
          </div>

          <div class="flex flex-col gap-2">
            <label class="text-sm font-semibold text-main ml-1">Actions</label>
            <div id="actions-builder" class="flex flex-col gap-2"></div>
            <button type="button" id="add-action" class="neu-transition px-4 py-2 rounded-xl font-semibold neu-convex text-accent text-sm self-start">+ Add action</button>
          </div>

          <!-- Hidden JSON state synced from the visual builders -->
          <input type="hidden" name="conditions" id="conditions-json" value="{}" />
          <input type="hidden" name="actions" id="actions-json" value="[]" />

          <label class="flex items-center gap-3 text-sm font-semibold text-main">
            <input type="checkbox" name="is_active" checked />
            Active
          </label>
          <div class="flex flex-wrap gap-3 pt-2">
            <NeuButton type="submit" variant="accent" size="md" id="save-btn">Create</NeuButton>
            <button type="button" id="test-btn" class="neu-transition px-6 py-3 rounded-2xl font-semibold neu-convex text-main text-sm">Test Rule</button>
            <button type="button" id="reset-btn" class="neu-transition px-6 py-3 rounded-2xl font-semibold text-muted hover:text-main text-sm">Reset</button>
          </div>
        </form>

        <div id="test-result" class="mt-4 p-4 rounded-2xl neu-sunken text-sm" style="display:none;"></div>
      </NeuCard>

      <NeuCard class="lg:col-span-2 overflow-hidden p-0">
        <table class="w-full text-left">
          <thead class="neu-sunken text-xs uppercase text-muted">
            <tr>
              <th class="px-6 py-4 font-semibold">Name</th>
              <th class="px-6 py-4 font-semibold">Trigger</th>
              <th class="px-6 py-4 font-semibold">Status</th>
              <th class="px-6 py-4 font-semibold">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y" id="automations-body">
            {automations.length > 0 ? automations.map((rule) => (
              <tr class="hover:bg-white/30 transition-colors auto-row" data-id={rule.id} data-rule={JSON.stringify(rule)}>
                <td class="px-6 py-4">
                  <p class="font-semibold text-main">{rule.name}</p>
                  {rule.description && <p class="text-xs text-muted">{rule.description}</p>}
                </td>
                <td class="px-6 py-4 text-sm text-muted">{rule.trigger_type.replace('_', ' ')}</td>
                <td class="px-6 py-4">
                  {rule.is_active ? (
                    <NeuBadge variant="success">active</NeuBadge>
                  ) : (
                    <NeuBadge variant="default">inactive</NeuBadge>
                  )}
                </td>
                <td class="px-6 py-4">
                  <div class="flex items-center gap-2 flex-wrap">
                    <button class="auto-act neu-transition px-3 py-1 rounded-xl font-semibold neu-convex text-accent text-xs" data-act="edit">Edit</button>
                    <button class="auto-act neu-transition px-3 py-1 rounded-xl font-semibold neu-convex text-main text-xs" data-act="duplicate">Duplicate</button>
                    <button class="auto-act neu-transition px-3 py-1 rounded-xl font-semibold neu-convex text-rose-700 text-xs" data-act="delete">Delete</button>
                  </div>
                </td>
              </tr>
            )) : (
              <tr>
                <td colspan="4" class="px-6 py-12 text-center text-muted">
                  No automations configured yet.
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </NeuCard>
    </div>
  </div>

  <script is:inline define:vars={{ token, API_URL, automationsJson, conditionFields, conditionOperators, actionTypes }}>
    (function () {
      const automations = JSON.parse(automationsJson);
      const condBuilder = document.getElementById('conditions-builder');
      const actBuilder = document.getElementById('actions-builder');
      const condJson = document.getElementById('conditions-json');
      const actJson = document.getElementById('actions-json');
      const addCondBtn = document.getElementById('add-condition');
      const addActBtn = document.getElementById('add-action');
      const form = document.getElementById('automation-form');
      const testBtn = document.getElementById('test-btn');
      const resetBtn = document.getElementById('reset-btn');
      const testResult = document.getElementById('test-result');
      const builderTitle = document.getElementById('builder-title');
      const builderSubtitle = document.getElementById('builder-subtitle');
      const saveBtn = document.getElementById('save-btn');
      const editIdInput = document.getElementById('edit_id');
      const tbody = document.getElementById('automations-body');

      function opt(list, val) {
        return list.map((o) => `<option value="${o.value}" ${o.value === val ? 'selected' : ''}>${o.label}</option>`).join('');
      }

      // ─── Conditions ─────────────────────────────────────────────────
      function addCondition(c) {
        c = c || { field: 'status', op: 'equals', value: '' };
        const row = document.createElement('div');
        row.className = 'cond-row flex items-center gap-2 flex-wrap';
        row.innerHTML = `
          <select class="cond-field text-sm">${opt(conditionFields, c.field)}</select>
          <select class="cond-op text-sm">${opt(conditionOperators, c.op)}</select>
          <input type="text" class="cond-value text-sm" placeholder="value" value="${escapeAttr(c.value)}" />
          <button type="button" class="cond-del neu-transition px-3 py-1 rounded-xl font-semibold neu-convex text-rose-700 text-xs">×</button>
        `;
        row.querySelector('.cond-del').addEventListener('click', () => { row.remove(); syncJson(); });
        condBuilder.appendChild(row);
        syncJson();
      }

      function readConditions() {
        const rows = condBuilder.querySelectorAll('.cond-row');
        // Conditions are stored as an object: { field: { op: value } } for simple
        // equality, or as an array of clause objects when multiple conditions exist.
        const clauses = [];
        rows.forEach((r) => {
          clauses.push({
            field: r.querySelector('.cond-field').value,
            op: r.querySelector('.cond-op').value,
            value: r.querySelector('.cond-value').value,
          });
        });
        if (clauses.length === 0) return {};
        if (clauses.length === 1) {
          const c = clauses[0];
          if (c.op === 'equals') return { [c.field]: c.value };
          return { conditions: clauses };
        }
        return { conditions: clauses };
      }

      // ─── Actions ────────────────────────────────────────────────────
      const actionFieldsConfig = {
        change_status: [{ key: 'status', label: 'Status', placeholder: 'resolved' }],
        assign: [{ key: 'assignee', label: 'Assignee (user id or email)', placeholder: 'agent@example.com' }],
        send_email: [{ key: 'to', label: 'To', placeholder: 'user@example.com' }, { key: 'subject', label: 'Subject', placeholder: 'Subject' }, { key: 'template', label: 'Template', placeholder: 'ticket_updated' }],
        add_tag: [{ key: 'tag', label: 'Tag', placeholder: 'urgent' }],
      };

      function addAction(a) {
        a = a || { type: 'change_status', status: '' };
        const type = a.type || 'change_status';
        const row = document.createElement('div');
        row.className = 'act-row flex flex-col gap-2 p-3 rounded-xl neu-sunken';
        const fieldsHtml = (actionFieldsConfig[type] || []).map((f) => {
          return `<label class="text-xs font-semibold text-muted ml-1">${f.label}</label>
            <input type="text" class="act-field text-sm" data-key="${f.key}" placeholder="${f.placeholder}" value="${escapeAttr(a[f.key] || '')}" />`;
        }).join('');
        row.innerHTML = `
          <div class="flex items-center gap-2">
            <select class="act-type text-sm flex-1">${opt(actionTypes, type)}</select>
            <button type="button" class="act-del neu-transition px-3 py-1 rounded-xl font-semibold neu-convex text-rose-700 text-xs">×</button>
          </div>
          <div class="act-fields flex flex-col gap-2">${fieldsHtml}</div>
        `;
        row.querySelector('.act-type').addEventListener('change', (e) => {
          const newType = e.target.value;
          const fields = actionFieldsConfig[newType] || [];
          row.querySelector('.act-fields').innerHTML = fields.map((f) =>
            `<label class="text-xs font-semibold text-muted ml-1">${f.label}</label>
             <input type="text" class="act-field text-sm" data-key="${f.key}" placeholder="${f.placeholder}" value="" />`
          ).join('');
          syncJson();
        });
        row.querySelector('.act-del').addEventListener('click', () => { row.remove(); syncJson(); });
        actBuilder.appendChild(row);
        syncJson();
      }

      function readActions() {
        const rows = actBuilder.querySelectorAll('.act-row');
        const actions = [];
        rows.forEach((r) => {
          const type = r.querySelector('.act-type').value;
          const obj = { type };
          r.querySelectorAll('.act-field').forEach((f) => {
            obj[f.getAttribute('data-key')] = f.value;
          });
          actions.push(obj);
        });
        return actions;
      }

      function syncJson() {
        condJson.value = JSON.stringify(readConditions());
        actJson.value = JSON.stringify(readActions());
      }

      function escapeAttr(s) {
        return String(s == null ? '' : s).replace(/"/g, '&quot;').replace(/</g, '&lt;');
      }
      function escapeHtml(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
      }

      // ─── Load rule into builder (edit / duplicate) ───────────────────
      function loadRule(rule, isDuplicate) {
        form.querySelector('[name="name"]').value = isDuplicate ? rule.name + ' (copy)' : rule.name;
        form.querySelector('[name="description"]').value = rule.description || '';
        form.querySelector('[name="trigger_type"]').value = rule.trigger_type;
        form.querySelector('[name="is_active"]').checked = rule.is_active;
        editIdInput.value = isDuplicate ? '' : (rule.id || '');

        // Reset builders.
        condBuilder.innerHTML = '';
        actBuilder.innerHTML = '';

        // Normalise conditions into clause list.
        const cond = rule.conditions || {};
        let clauses = [];
        if (Array.isArray(cond.conditions)) {
          clauses = cond.conditions;
        } else if (Object.keys(cond).length) {
          clauses = Object.entries(cond).map(([field, value]) => {
            if (value && typeof value === 'object' && !Array.isArray(value)) {
              return { field, op: value.op || 'equals', value: value.value || '' };
            }
            return { field, op: 'equals', value };
          });
        }
        if (!clauses.length) clauses = [{ field: 'status', op: 'equals', value: '' }];
        clauses.forEach((c) => addCondition({ field: c.field, op: c.op, value: String(c.value == null ? '' : c.value) }));

        // Actions.
        const acts = Array.isArray(rule.actions) ? rule.actions : [];
        if (!acts.length) acts.push({ type: 'change_status', status: '' });
        acts.forEach((a) => addAction(a));

        if (isDuplicate) {
          builderTitle.textContent = 'Duplicate automation';
          builderSubtitle.textContent = 'A copy will be created on save.';
          saveBtn.textContent = 'Create Copy';
        } else {
          builderTitle.textContent = 'Edit automation';
          builderSubtitle.textContent = 'Changes will update the existing rule.';
          saveBtn.textContent = 'Update';
        }
        // Switch form to PUT semantics when editing.
        form.method = isDuplicate ? 'POST' : 'POST';
        if (!isDuplicate && rule.id) {
          // Mark for client-side PUT handling on submit.
          form.setAttribute('data-edit-id', rule.id);
        } else {
          form.removeAttribute('data-edit-id');
        }
        syncJson();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      // ─── Row actions (edit / duplicate / delete) ─────────────────────
      tbody.addEventListener('click', async (e) => {
        const btn = e.target.closest('.auto-act');
        if (!btn) return;
        const row = btn.closest('.auto-row');
        const id = row.getAttribute('data-id');
        const rule = JSON.parse(row.getAttribute('data-rule'));
        const act = btn.getAttribute('data-act');

        if (act === 'edit') {
          loadRule(rule, false);
          return;
        }
        if (act === 'duplicate') {
          loadRule(rule, true);
          return;
        }
        if (act === 'delete') {
          if (!confirm(`Delete automation "${rule.name}"? This cannot be undone.`)) return;
          try {
            const res = await fetch(`${API_URL}/api/v1/admin/automations/${id}`, {
              method: 'DELETE',
              headers: { 'Content-Type': 'application/json', 'X-Tenant-ID': 'default', Authorization: `Bearer ${token}` },
              credentials: 'include',
            });
            if (!res.ok) {
              const b = await res.json().catch(() => ({}));
              throw new Error(b.error || `Request failed (${res.status})`);
            }
            window.location.reload();
          } catch (err) { alert(err.message); }
        }
      });

      // ─── Submit: create or update ───────────────────────────────────
      form.addEventListener('submit', async (e) => {
        syncJson();
        const editId = form.getAttribute('data-edit-id') || editIdInput.value;
        if (editId) {
          e.preventDefault();
          const body = {
            name: form.querySelector('[name="name"]').value,
            description: form.querySelector('[name="description"]').value,
            trigger_type: form.querySelector('[name="trigger_type"]').value,
            conditions: JSON.parse(condJson.value),
            actions: JSON.parse(actJson.value),
            is_active: form.querySelector('[name="is_active"]').checked,
          };
          try {
            const res = await fetch(`${API_URL}/api/v1/admin/automations/${editId}`, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json', 'X-Tenant-ID': 'default', Authorization: `Bearer ${token}` },
              credentials: 'include',
              body: JSON.stringify(body),
            });
            if (!res.ok) {
              const b = await res.json().catch(() => ({}));
              throw new Error(b.error || `Request failed (${res.status})`);
            }
            window.location.reload();
          } catch (err) { alert(err.message); }
        }
      });

      // ─── Test rule ──────────────────────────────────────────────────
      testBtn.addEventListener('click', async () => {
        syncJson();
        const body = {
          trigger_type: form.querySelector('[name="trigger_type"]').value,
          conditions: JSON.parse(condJson.value),
          actions: JSON.parse(actJson.value),
        };
        testResult.style.display = 'block';
        testResult.className = 'mt-4 p-4 rounded-2xl neu-sunken text-sm text-muted';
        testResult.textContent = 'Testing rule…';
        try {
          const res = await fetch(`${API_URL}/api/v1/admin/automations/test`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-Tenant-ID': 'default', Authorization: `Bearer ${token}` },
            credentials: 'include',
            body: JSON.stringify(body),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error || `Request failed (${res.status})`);
          const matched = data.matched != null ? data.matched : (data.tickets || []).length;
          const tickets = data.tickets || [];
          testResult.className = 'mt-4 p-4 rounded-2xl neu-sunken text-sm text-emerald-700';
          let html = `<p class="font-semibold mb-2">${matched} ticket${matched === 1 ? '' : 's'} would match this rule.</p>`;
          if (tickets.length) {
            html += '<ul class="flex flex-col gap-1 text-muted">' + tickets.slice(0, 10).map((t) =>
              `<li>• ${escapeHtml(t.title || t.id)} — ${escapeHtml(t.status || '')}</li>`
            ).join('') + '</ul>';
          }
          testResult.innerHTML = html;
        } catch (err) {
          testResult.className = 'mt-4 p-4 rounded-2xl neu-sunken text-sm text-rose-700';
          testResult.textContent = 'Test failed: ' + (err.message || 'unknown error');
        }
      });

      // ─── Reset builder ──────────────────────────────────────────────
      resetBtn.addEventListener('click', () => {
        form.reset();
        form.removeAttribute('data-edit-id');
        editIdInput.value = '';
        condBuilder.innerHTML = '';
        actBuilder.innerHTML = '';
        addCondition();
        addAction();
        builderTitle.textContent = 'Create automation';
        builderSubtitle.textContent = 'Build conditions and actions visually.';
        saveBtn.textContent = 'Create';
        syncJson();
      });

      addCondBtn.addEventListener('click', () => addCondition());
      addActBtn.addEventListener('click', () => addAction());

      // Initial state: one empty condition + one empty action.
      addCondition();
      addAction();
      syncJson();
    })();
  </script>
</Layout>
