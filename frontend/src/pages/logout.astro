---
import { API_URL } from '../lib/api';

// Direct navigation to /logout (e.g. a bookmark) — the Sidebar's logout
// button calls POST /auth/logout client-side instead, which is the normal
// path. This SSR fallback best-effort revokes the session too: the CSRF
// middleware applies to /auth/logout, so the CSRF cookie has to be forwarded
// manually since this is a server-to-server call, not a browser fetch.
const token = Astro.cookies.get('trickreport_token')?.value;
const csrfToken = Astro.cookies.get('trickreport_csrf')?.value;

if (token) {
  try {
    await fetch(`${API_URL}/api/v1/auth/logout`, {
      method: 'POST',
      headers: {
        Authorization: `Bearer ${token}`,
        ...(csrfToken
          ? { 'X-CSRF-Token': csrfToken, Cookie: `trickreport_csrf=${csrfToken}` }
          : {}),
      },
    });
  } catch {
    // Best-effort — cookies are cleared below regardless of the outcome.
  }
}

Astro.cookies.delete('trickreport_token', { path: '/' });
Astro.cookies.delete('trickreport_refresh', { path: '/' });
return Astro.redirect('/login');
---
