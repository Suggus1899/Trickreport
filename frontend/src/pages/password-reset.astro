---
import Layout from '../layouts/Layout.astro';
import { PasswordResetRequestForm } from '../components/auth/PasswordResetRequestForm';
import { KeyRound } from 'lucide-react';

if (Astro.locals.user) {
  return Astro.redirect('/dashboard');
}
---

<Layout title="Reset password">
  <div class="min-h-screen flex flex-col items-center justify-center gap-8 p-4">
    <div
      class="flex flex-col items-center gap-3 animate-in fade-in-0 slide-in-from-bottom-2 duration-300"
    >
      <div class="w-16 h-16 rounded-2xl bg-primary/10 flex items-center justify-center">
        <KeyRound className="size-8 text-primary" aria-hidden="true" />
      </div>
      <h1 class="font-heading text-3xl font-bold tracking-tight">Reset password</h1>
      <p class="text-sm text-muted-foreground">We'll email you a link to set a new one</p>
    </div>

    <div
      class="w-full max-w-md rounded-xl border bg-card text-card-foreground shadow-sm p-8 animate-in fade-in-0 slide-in-from-bottom-2 duration-300 fill-mode-backwards"
      style="animation-delay: 60ms"
    >
      <PasswordResetRequestForm client:load />

      <p class="text-center text-sm text-muted-foreground mt-6 pt-6 border-t">
        Remembered it?
        <a href="/login" class="font-semibold text-primary hover:underline">Back to sign in</a>
      </p>
    </div>
  </div>
</Layout>
