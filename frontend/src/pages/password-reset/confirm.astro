---
import Layout from '../../layouts/Layout.astro';
import { PasswordResetConfirmForm } from '../../components/auth/PasswordResetConfirmForm';
import { KeyRound } from 'lucide-react';

if (Astro.locals.user) {
  return Astro.redirect('/dashboard');
}

// The token arrives in the link the API emails out (see ResetURL in wire.go).
const token = Astro.url.searchParams.get('token') ?? '';
---

<Layout title="Choose a new password">
  <div class="min-h-screen flex flex-col items-center justify-center gap-8 p-4">
    <div
      class="flex flex-col items-center gap-3 animate-in fade-in-0 slide-in-from-bottom-2 duration-300"
    >
      <div class="w-16 h-16 rounded-2xl bg-primary/10 flex items-center justify-center">
        <KeyRound className="size-8 text-primary" aria-hidden="true" />
      </div>
      <h1 class="font-heading text-3xl font-bold tracking-tight">Choose a new password</h1>
    </div>

    <div
      class="w-full max-w-md rounded-xl border bg-card text-card-foreground shadow-sm p-8 animate-in fade-in-0 slide-in-from-bottom-2 duration-300 fill-mode-backwards"
      style="animation-delay: 60ms"
    >
      {
        token ? (
          <PasswordResetConfirmForm token={token} client:load />
        ) : (
          <div class="flex flex-col gap-5">
            <p class="text-sm text-destructive" role="alert">
              This link is missing its reset token. Open the link from your email exactly as it was
              sent, or request a new one.
            </p>
            <a
              href="/password-reset"
              class="inline-flex h-11 w-full items-center justify-center rounded-md bg-primary px-8 text-sm font-medium text-primary-foreground no-underline hover:bg-primary/90"
            >
              Request a new link
            </a>
          </div>
        )
      }

      <p class="text-center text-sm text-muted-foreground mt-6 pt-6 border-t">
        <a href="/login" class="font-semibold text-primary hover:underline">Back to sign in</a>
      </p>
    </div>
  </div>
</Layout>
