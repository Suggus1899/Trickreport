---
import Layout from '../../layouts/Layout.astro';
import NeuCard from '../../components/NeuCard.astro';
import NeuButton from '../../components/NeuButton.astro';
import OnlineStatus from '../../components/OnlineStatus.astro';
import { getMe, API_URL } from '../../lib/api';

const token = Astro.cookies.get('trickreport_token')?.value;
if (!token) {
  return Astro.redirect('/login');
}

let me;
try {
  me = await getMe(token);
} catch {
  return Astro.redirect('/login');
}
---

<Layout title="Sync Status — Trickreport" user={me ? { name: me.name, role: me.role } : undefined}>
  <div class="max-w-4xl mx-auto py-8">
    <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
      <div>
        <h1 class="text-2xl font-bold text-main">Offline Sync Status</h1>
        <p class="text-muted text-sm">Pending tickets, conflicts and sync controls</p>
      </div>
      <div class="flex items-center gap-3">
        <OnlineStatus />
        <NeuButton href="/tickets" variant="raised" size="sm">Back to Tickets</NeuButton>
      </div>
    </div>

    <NeuCard class="mb-6">
      <div class="flex items-center justify-between flex-wrap gap-3">
        <div>
          <p class="text-sm text-muted">Pending: <span id="stat-pending" class="font-bold text-main">0</span></p>
          <p class="text-sm text-muted">Conflicts: <span id="stat-conflicts" class="font-bold text-rose-700">0</span></p>
          <p class="text-sm text-muted">Errors: <span id="stat-errors" class="font-bold text-amber-700">0</span></p>
        </div>
        <button id="sync-all" type="button" class="neu-transition px-6 py-3 rounded-2xl font-semibold neu-convex text-accent">
          Sync all
        </button>
      </div>
      <div id="sync-result" class="mt-4 p-4 rounded-2xl neu-sunken text-sm" style="display:none;"></div>
    </NeuCard>

    <NeuCard>
      <div id="pending-list" class="flex flex-col gap-4">
        <p class="text-muted text-center py-6">Loading pending tickets…</p>
      </div>
    </NeuCard>
  </div>

  <script is:inline define:vars={{ token, API_URL }}>
    (function () {
      const DB_NAME = 'trickreport-offline';
      const STORE = 'pending_tickets';
      const listEl = document.getElementById('pending-list');
      const syncAllBtn = document.getElementById('sync-all');
      const syncResult = document.getElementById('sync-result');
      const statPending = document.getElementById('stat-pending');
      const statConflicts = document.getElementById('stat-conflicts');
      const statErrors = document.getElementById('stat-errors');

      function openDB() {
        return new Promise((resolve, reject) => {
          const req = indexedDB.open(DB_NAME, 1);
          req.onupgradeneeded = () => {
            const db = req.result;
            if (!db.objectStoreNames.contains(STORE)) db.createObjectStore(STORE, { keyPath: 'id' });
          };
          req.onsuccess = () => resolve(req.result);
          req.onerror = () => reject(req.error);
        });
      }
      function store(db, mode) { return db.transaction(STORE, mode).objectStore(STORE); }
      function reqP(req) {
        return new Promise((resolve, reject) => { req.onsuccess = () => resolve(req.result); req.onerror = () => reject(req.error); });
      }
      async function getAll() {
        const db = await openDB();
        const all = await reqP(store(db, 'readonly').getAll());
        db.close();
        return all.sort((a, b) => a.createdAt - b.createdAt);
      }
      async function put(ticket) {
        const db = await openDB();
        await reqP(store(db, 'readwrite').put(ticket));
        db.close();
      }
      async function del(id) {
        const db = await openDB();
        await reqP(store(db, 'readwrite').delete(id));
        db.close();
      }

      async function attemptSync(ticket) {
        const res = await fetch(`${API_URL}/api/v1/tickets`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-Tenant-ID': 'default', Authorization: `Bearer ${token}` },
          credentials: 'include',
          body: JSON.stringify(ticket.data),
        });
        if (res.status === 409) {
          const body = await res.json().catch(() => ({}));
          ticket.status = 'conflict';
          ticket.serverVersion = body.ticket || body.server_version || body;
          ticket.error = body.error || 'Conflict detected — server has a conflicting record.';
          ticket.lastAttempt = Date.now();
          await put(ticket);
          return;
        }
        if (!res.ok) {
          const body = await res.json().catch(() => ({}));
          throw new Error(body.error || `Request failed (${res.status})`);
        }
        await del(ticket.id);
      }

      function statusBadge(ticket) {
        const s = ticket.status || 'pending';
        const map = {
          pending: { cls: 'text-main', label: 'Pending' },
          conflict: { cls: 'text-rose-700', label: 'Conflict' },
          error: { cls: 'text-amber-700', label: 'Error' },
          synced: { cls: 'text-emerald-700', label: 'Synced' },
        };
        const m = map[s] || map.pending;
        return `<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold neu-convex ${m.cls}">${m.label}</span>`;
      }

      function renderList(tickets) {
        statPending.textContent = tickets.filter((t) => (t.status || 'pending') === 'pending').length;
        statConflicts.textContent = tickets.filter((t) => t.status === 'conflict').length;
        statErrors.textContent = tickets.filter((t) => t.status === 'error').length;

        if (!tickets.length) {
          listEl.innerHTML = '<p class="text-muted text-center py-6">No pending offline tickets. Everything is in sync.</p>';
          return;
        }
        listEl.innerHTML = tickets.map((t) => `
          <div class="sync-row p-4 rounded-2xl neu-sunken flex flex-col gap-3" data-id="${t.id}">
            <div class="flex items-center justify-between gap-3 flex-wrap">
              <div>
                <p class="font-semibold text-main">${escapeHtml(t.data.title || '(untitled)')}</p>
                <p class="text-xs text-muted">Created ${new Date(t.createdAt).toLocaleString()} · ${escapeHtml(t.data.priority || 'medium')} · ${escapeHtml(t.data.category || 'general')}</p>
              </div>
              ${statusBadge(t)}
            </div>
            ${t.error ? `<p class="text-xs text-rose-700">${escapeHtml(t.error)}</p>` : ''}
            ${t.serverVersion ? `<div class="p-3 rounded-xl neu-concave text-xs">
              <p class="font-semibold mb-1">Server version:</p>
              <pre class="whitespace-pre-wrap text-muted">${escapeHtml(JSON.stringify(t.serverVersion, null, 2))}</pre>
            </div>` : ''}
            <div class="flex items-center gap-2 flex-wrap">
              <button class="act-btn neu-transition px-4 py-2 rounded-xl font-semibold neu-convex text-accent text-sm" data-act="retry">Retry</button>
              ${t.status === 'conflict' ? `
                <button class="act-btn neu-transition px-4 py-2 rounded-xl font-semibold neu-convex text-emerald-700 text-sm" data-act="local">Keep local</button>
                <button class="act-btn neu-transition px-4 py-2 rounded-xl font-semibold neu-convex text-main text-sm" data-act="server">Keep server</button>
              ` : ''}
              <button class="act-btn neu-transition px-4 py-2 rounded-xl font-semibold neu-convex text-rose-700 text-sm" data-act="delete">Delete</button>
            </div>
          </div>
        `).join('');

        listEl.querySelectorAll('.sync-row').forEach((row) => {
          const id = row.getAttribute('data-id');
          row.querySelectorAll('.act-btn').forEach((btn) => {
            btn.addEventListener('click', async () => {
              const act = btn.getAttribute('data-act');
              const ticket = tickets.find((x) => x.id === id);
              if (!ticket) return;
              try {
                if (act === 'delete') {
                  if (!confirm('Delete this pending ticket permanently?')) return;
                  await del(id);
                } else if (act === 'retry') {
                  ticket.status = 'pending';
                  ticket.error = undefined;
                  await put(ticket);
                  await attemptSync(ticket);
                } else if (act === 'local') {
                  ticket.status = 'pending';
                  ticket.error = undefined;
                  ticket.serverVersion = undefined;
                  await put(ticket);
                  await attemptSync(ticket);
                } else if (act === 'server') {
                  await del(id);
                }
                await refresh();
              } catch (err) {
                showSync('Action failed: ' + (err && err.message || 'unknown error'), true);
                await refresh();
              }
            });
          });
        });
      }

      function escapeHtml(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
      }

      function showSync(msg, isError) {
        syncResult.style.display = 'block';
        syncResult.textContent = msg;
        syncResult.className = 'mt-4 p-4 rounded-2xl neu-sunken text-sm ' + (isError ? 'text-rose-700' : 'text-emerald-700');
      }

      async function refresh() {
        const tickets = await getAll();
        renderList(tickets);
      }

      syncAllBtn.addEventListener('click', async () => {
        if (!navigator.onLine) { showSync("You're offline. Try again when connected.", true); return; }
        syncResult.style.display = 'block';
        syncResult.className = 'mt-4 p-4 rounded-2xl neu-sunken text-sm text-muted';
        syncResult.textContent = 'Syncing…';
        let synced = 0;
        try {
          const tickets = await getAll();
          for (const t of tickets) {
            if (t.status === 'conflict') continue;
            try { await attemptSync(t); synced++; } catch (err) { console.warn(err); break; }
          }
          showSync(synced > 0 ? `Synced ${synced} ticket${synced > 1 ? 's' : ''} successfully.` : 'No new tickets synced.', false);
          await refresh();
        } catch (err) {
          showSync('Sync failed: ' + (err && err.message || 'unknown error'), true);
        }
      });

      window.addEventListener('online', refresh);
      refresh();
    })();
  </script>
</Layout>
