---
import Layout from '../../layouts/Layout.astro';
import { buttonVariants } from '../../components/ui/button';
import { SyncStatus } from '../../components/tickets/SyncStatus';

const token = Astro.locals.token;
if (!token) {
  return Astro.redirect('/login');
}

const me = Astro.locals.user!;
---

<Layout title="Sync Status — Trickreport" user={me ? { name: me.name, role: me.role } : undefined}>
  <div class="max-w-4xl mx-auto py-8">
    <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
      <div>
        <h1 class="text-2xl font-bold">Offline Sync Status</h1>
        <p class="text-sm text-muted-foreground">Pending tickets, conflicts and sync controls</p>
      </div>
      <a href="/tickets" class={buttonVariants({ variant: 'outline', size: 'sm' })}>Back to Tickets</a>
    </div>

    <SyncStatus identity={{ userId: me.id, tenantId: me.tenant_id }} client:load />
  </div>
</Layout>
