---
import Layout from '../../layouts/Layout.astro';
import NeuCard from '../../components/NeuCard.astro';
import NeuInput from '../../components/NeuInput.astro';
import NeuButton from '../../components/NeuButton.astro';
import { getMe, createTicket } from '../../lib/api';

const token = Astro.cookies.get('trickreport_token')?.value;
if (!token) {
  return Astro.redirect('/login');
}

let me;
try {
  me = await getMe(token);
} catch {
  return Astro.redirect('/login');
}

let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const title = form.get('title')?.toString() || '';
  const description = form.get('description')?.toString() || '';
  const priority = form.get('priority')?.toString() || 'medium';
  const category = form.get('category')?.toString() || 'general';
  try {
    await createTicket(token, { title, description, priority, category });
    return Astro.redirect('/tickets');
  } catch (e: any) {
    error = e?.message || 'Failed to create ticket';
  }
}

const priorities = [
  { value: 'low', label: 'Low' },
  { value: 'medium', label: 'Medium' },
  { value: 'high', label: 'High' },
  { value: 'critical', label: 'Critical' },
];
---

<Layout title="New Ticket - Trickreport" user={me ? { name: me.name, role: me.role } : undefined}>
  <div class="max-w-4xl mx-auto py-8">
    <h1 class="text-2xl font-bold text-main mb-6">New Ticket</h1>
    <NeuCard>
      <form method="POST" class="flex flex-col gap-5">
        {error && (
          <div class="p-4 rounded-2xl neu-sunken text-rose-700 text-sm">
            {error}
          </div>
        )}
        <NeuInput label="Title" name="title" type="text" required minlength={3} />
        <div class="flex flex-col gap-2">
          <label for="description" class="text-sm font-semibold text-main ml-1">Description <span class="text-rose-700">*</span></label>
          <textarea
            id="description"
            name="description"
            required
            minlength={10}
            rows={5}
            class="resize-y"
          ></textarea>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div class="flex flex-col gap-2">
            <label for="priority" class="text-sm font-semibold text-main ml-1">Priority</label>
            <select id="priority" name="priority">
              {priorities.map((p) => <option value={p.value}>{p.label}</option>)}
            </select>
          </div>
          <NeuInput label="Category" name="category" type="text" value="general" />
        </div>
        <div class="flex items-center justify-end gap-3 pt-2">
          <a href="/tickets" class="neu-transition px-6 py-3 rounded-2xl font-semibold text-muted hover:text-main">Cancel</a>
          <NeuButton type="submit" variant="accent">Create Ticket</NeuButton>
        </div>
      </form>
    </NeuCard>
  </div>
</Layout>
