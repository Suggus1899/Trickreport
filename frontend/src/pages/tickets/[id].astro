---
import Layout from '../../layouts/Layout.astro';
import { TicketActions } from '../../components/tickets/TicketActions';
import {
  getMe,
  getTicket,
  getTicketComments,
  getTicketHistory,
  getTicketAttachments,
  getUsers,
} from '../../lib/api';
import type { Ticket, Comment, HistoryEntry, Attachment, User } from '../../lib/api';

const { id } = Astro.params;
const token = Astro.cookies.get('trickreport_token')?.value;
if (!token || !id) {
  return Astro.redirect('/login');
}

let user: User | undefined;
let ticket: Ticket | null = null;
let comments: Comment[] = [];
let history: HistoryEntry[] = [];
let attachments: Attachment[] = [];
let users: User[] = [];
let error = '';

try {
  user = await getMe(token);
  ticket = await getTicket(id, token);
  [comments, history, attachments] = await Promise.all([
    getTicketComments(id, token).catch(() => [] as Comment[]),
    getTicketHistory(id, token).catch(() => [] as HistoryEntry[]),
    getTicketAttachments(id, token).catch(() => [] as Attachment[]),
  ]);
  if (user.role === 'admin' || user.role === 'agent') {
    users = await getUsers(token).catch(() => [] as User[]);
  }
} catch (err) {
  error = err instanceof Error ? err.message : 'Failed to load ticket';
}

const canManage = user?.role === 'admin' || user?.role === 'agent';
---

<Layout title={ticket?.title || 'Ticket'} user={user ? { name: user.name, role: user.role } : undefined}>
  <div class="max-w-4xl mx-auto">
    <div class="flex items-center justify-between mb-8">
      <a href="/tickets" class="text-sm font-semibold text-muted-foreground hover:text-foreground">&larr; Back</a>
      <h1 class="text-2xl font-bold">{ticket?.title || 'Ticket'}</h1>
      <span></span>
    </div>

    {error && (
      <div class="rounded-xl border border-destructive/30 bg-destructive/5 p-4 text-sm text-destructive mb-6">{error}</div>
    )}

    {ticket && (
      <div class="flex flex-col gap-6">
        <div class="rounded-xl border bg-card p-5">
          <p class="whitespace-pre-wrap">{ticket.description}</p>
          <div class="mt-6 text-sm text-muted-foreground">
            Created by {ticket.creator_name || ticket.created_by} on {new Date(ticket.created_at).toLocaleString()}
          </div>
        </div>

        <TicketActions
          client:load
          ticketId={ticket.id}
          initialTicket={ticket}
          initialComments={comments}
          initialAttachments={attachments}
          users={users}
          canManage={canManage}
        />

        <div class="rounded-xl border bg-card p-5">
          <h2 class="text-lg font-semibold mb-4">History</h2>
          {history.length > 0 ? (
            <ol class="flex flex-col gap-3">
              {history.map((entry) => (
                <li class="flex gap-3 items-start">
                  <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-primary/40"></span>
                  <div class="text-sm">
                    <span class="font-semibold">{entry.changed_by_name || entry.changed_by}</span>
                    {' changed '}
                    <span class="font-semibold">{entry.field.replace('_', ' ')}</span>
                    {' from '}
                    <span class="text-muted-foreground">{entry.old_value || '—'}</span>
                    {' to '}
                    <span class="text-primary">{entry.new_value || '—'}</span>
                    <span class="text-xs text-muted-foreground block">{new Date(entry.created_at).toLocaleString()}</span>
                  </div>
                </li>
              ))}
            </ol>
          ) : (
            <p class="text-sm text-muted-foreground">No history recorded.</p>
          )}
        </div>
      </div>
    )}
  </div>
</Layout>
