---
import Layout from '../../layouts/Layout.astro';
import { TicketActions } from '../../components/tickets/TicketActions';
import { ArrowLeft, RefreshCw, UserCheck, Flag, Pencil } from 'lucide-react';
import {
  getMe,
  getTicket,
  getTicketComments,
  getTicketHistory,
  getTicketAttachments,
  getAssignableUsers,
} from '../../lib/api';
import type { Ticket, Comment, HistoryEntry, Attachment, User } from '../../lib/api';

const { id } = Astro.params;
const token = Astro.cookies.get('trickreport_token')?.value;
if (!token || !id) {
  return Astro.redirect('/login');
}

let user: User | undefined;
let ticket: Ticket | null = null;
let comments: Comment[] = [];
let history: HistoryEntry[] = [];
let attachments: Attachment[] = [];
let users: User[] = [];
let error = '';

try {
  user = await getMe(token);
  ticket = await getTicket(id, token);
  [comments, history, attachments] = await Promise.all([
    getTicketComments(id, token).catch(() => [] as Comment[]),
    getTicketHistory(id, token).catch(() => [] as HistoryEntry[]),
    getTicketAttachments(id, token).catch(() => [] as Attachment[]),
  ]);
  users = await getAssignableUsers(user.role, token).catch(() => [] as User[]);
} catch (err) {
  error = err instanceof Error ? err.message : 'Failed to load ticket';
}

const canManage = user?.role === 'admin' || user?.role === 'agent';

const HISTORY_ICON: Record<string, typeof RefreshCw> = {
  status: RefreshCw,
  assigned_to: UserCheck,
  priority: Flag,
};
---

<Layout title={ticket?.title || 'Ticket'} user={user ? { name: user.name, role: user.role } : undefined}>
  <div class="max-w-4xl mx-auto">
    <a href="/tickets" class="inline-flex items-center gap-1.5 text-sm font-semibold text-muted-foreground hover:text-foreground transition-colors mb-4">
      <ArrowLeft className="size-4" aria-hidden="true" />
      Back to tickets
    </a>

    {error && (
      <div class="rounded-xl border border-destructive/30 bg-destructive/5 p-4 text-sm text-destructive mb-6">{error}</div>
    )}

    {ticket && (
      <div class="flex flex-col gap-6">
        <header>
          <div class="flex items-baseline gap-2 flex-wrap">
            <h1 class="font-heading text-2xl font-bold">{ticket.title}</h1>
            <span class="text-xs font-mono text-muted-foreground" title="Ticket ID">
              #{ticket.id.slice(0, 8)}
            </span>
          </div>
        </header>

        <div class="rounded-xl border bg-card p-5">
          <p class="whitespace-pre-wrap">{ticket.description}</p>
          <div class="mt-6 text-sm text-muted-foreground">
            Created by {ticket.creator_name || ticket.created_by} on {new Date(ticket.created_at).toLocaleString()}
          </div>
        </div>

        <TicketActions
          client:load
          ticketId={ticket.id}
          initialTicket={ticket}
          initialComments={comments}
          initialAttachments={attachments}
          users={users}
          canManage={canManage}
        />

        <div class="rounded-xl border bg-card p-5">
          <h2 class="font-heading font-semibold mb-4">History</h2>
          {history.length > 0 ? (
            <ol class="relative flex flex-col gap-5 before:absolute before:left-[15px] before:top-2 before:bottom-2 before:w-px before:bg-border">
              {history.map((entry) => {
                const Icon = HISTORY_ICON[entry.field] ?? Pencil;
                return (
                  <li class="relative flex gap-3 items-start pl-0">
                    <span class="relative z-10 flex items-center justify-center size-8 shrink-0 rounded-full bg-muted border">
                      <Icon className="size-3.5 text-muted-foreground" aria-hidden="true" />
                    </span>
                    <div class="text-sm pt-1">
                      <span class="font-semibold">{entry.user_name || entry.user_id}</span>
                      {' changed '}
                      <span class="font-semibold">{entry.field.replace('_', ' ')}</span>
                      {' from '}
                      <span class="text-muted-foreground">{entry.old_value || '—'}</span>
                      {' to '}
                      <span class="text-primary font-medium">{entry.new_value || '—'}</span>
                      <span class="text-xs text-muted-foreground block">{new Date(entry.created_at).toLocaleString()}</span>
                    </div>
                  </li>
                );
              })}
            </ol>
          ) : (
            <p class="text-sm text-muted-foreground">No history recorded.</p>
          )}
        </div>
      </div>
    )}
  </div>
</Layout>
