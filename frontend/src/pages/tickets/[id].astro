---
import Layout from '../../layouts/Layout.astro';
import NeuCard from '../../components/NeuCard.astro';
import NeuButton from '../../components/NeuButton.astro';
import { getMe, api } from '../../lib/api';
import type { Ticket } from '../../lib/api';

const { id } = Astro.params;
const token = Astro.cookies.get('trickreport_token')?.value;
if (!token || !id) {
  return Astro.redirect('/login');
}

let user;
let ticket: Ticket | null = null;
let error = '';

try {
  user = await getMe(token);
  ticket = await api<Ticket>(`/tickets/${id}`, { token });
} catch (err) {
  error = err instanceof Error ? err.message : 'Failed to load ticket';
}

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const content = data.get('content')?.toString() || '';
  try {
    await api(`/tickets/${id}/comments`, {
      token,
      method: 'POST',
      body: JSON.stringify({ content, is_internal: false }),
    });
    return Astro.redirect(`/tickets/${id}`);
  } catch (err) {
    error = err instanceof Error ? err.message : 'Failed to add comment';
  }
}
---

<Layout title={ticket?.title || 'Ticket'} user={user ? { name: user.name, role: user.role } : undefined}>
  <div class="max-w-4xl mx-auto">
    <div class="flex items-center justify-between mb-8">
      <NeuButton href="/tickets" variant="raised" size="sm">Back</NeuButton>
      <h1 class="text-2xl font-bold">{ticket?.title || 'Ticket'}</h1>
      <span></span>
    </div>

    {error && (
      <NeuCard variant="sunken" class="mb-6 text-rose-700">{error}</NeuCard>
    )}

    {ticket && (
      <div class="flex flex-col gap-6">
        <NeuCard>
          <div class="flex flex-wrap gap-3 mb-4">
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase neu-convex text-main">{ticket.status.replace('_', ' ')}</span>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase neu-convex text-main">{ticket.priority}</span>
            {ticket.sla_breached && (
              <span class="px-3 py-1 rounded-full text-xs font-bold uppercase neu-convex text-rose-700">SLA Breached</span>
            )}
          </div>
          <p class="text-main whitespace-pre-wrap">{ticket.description}</p>
          <div class="mt-6 text-sm text-muted">
            Created by {ticket.creator_name || ticket.created_by} on {new Date(ticket.created_at).toLocaleString()}
          </div>
        </NeuCard>

        <NeuCard>
          <h2 class="text-lg font-semibold mb-4">Add comment</h2>
          <form method="POST" class="flex flex-col gap-4">
            <textarea name="content" placeholder="Write a comment..." required rows="3"></textarea>
            <div class="flex justify-end">
              <NeuButton type="submit" variant="accent" size="md">Post Comment</NeuButton>
            </div>
          </form>
        </NeuCard>
      </div>
    )}
  </div>
</Layout>
