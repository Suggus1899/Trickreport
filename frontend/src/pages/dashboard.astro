---
import Layout from '../layouts/Layout.astro';
import { buttonVariants } from '../components/ui/button';
import { getMe, getSummary } from '../lib/api';

const token = Astro.cookies.get('trickreport_token')?.value;
if (!token) {
  return Astro.redirect('/login');
}

let user;
let summary;
let error = '';

try {
  user = await getMe(token);
  summary = await getSummary(token);
} catch (err) {
  error = err instanceof Error ? err.message : 'Failed to load dashboard';
}
---

<Layout title="Dashboard" user={user ? { name: user.name, role: user.role } : undefined}>
  <div class="max-w-6xl mx-auto">
    <header class="mb-8">
      <h1 class="text-3xl font-bold">Dashboard</h1>
      <p class="text-muted-foreground">Overview of your help desk</p>
    </header>

    {error && (
      <div class="rounded-xl border border-destructive/30 bg-destructive/5 p-4 text-sm text-destructive mb-6">{error}</div>
    )}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <div class="rounded-xl border bg-card p-5 flex flex-col gap-2">
        <span class="text-sm font-semibold text-muted-foreground uppercase tracking-wide">Total</span>
        <span class="text-4xl font-bold">{summary?.total_tickets ?? 0}</span>
      </div>
      <div class="rounded-xl border bg-card p-5 flex flex-col gap-2">
        <span class="text-sm font-semibold text-muted-foreground uppercase tracking-wide">Open</span>
        <span class="text-4xl font-bold text-primary">{summary?.open_tickets ?? 0}</span>
      </div>
      <div class="rounded-xl border bg-card p-5 flex flex-col gap-2">
        <span class="text-sm font-semibold text-muted-foreground uppercase tracking-wide">Resolved</span>
        <span class="text-4xl font-bold text-emerald-600">{summary?.resolved_tickets ?? 0}</span>
      </div>
      <div class="rounded-xl border bg-card p-5 flex flex-col gap-2">
        <span class="text-sm font-semibold text-muted-foreground uppercase tracking-wide">SLA Breached</span>
        <span class="text-4xl font-bold text-destructive">{summary?.sla_breached ?? 0}</span>
      </div>
    </div>

    <div class="rounded-xl border bg-card p-5">
      <h2 class="text-xl font-semibold mb-4">Quick actions</h2>
      <div class="flex flex-wrap gap-4">
        <a href="/tickets" class={buttonVariants({ variant: 'outline' })}>View Tickets</a>
        <a href="/tickets/new" class={buttonVariants({})}>Create Ticket</a>
      </div>
    </div>
  </div>
</Layout>
