---
import Layout from '../layouts/Layout.astro';
import { LoginForm } from '../components/auth/LoginForm';
import { Ticket } from 'lucide-react';

if (Astro.cookies.has('trickreport_token')) {
  return Astro.redirect('/dashboard');
}
---

<Layout title="Login">
  <div class="min-h-screen flex flex-col items-center justify-center gap-8 p-4">
    <div class="flex flex-col items-center gap-3 animate-in fade-in-0 slide-in-from-bottom-2 duration-300">
      <div class="w-16 h-16 rounded-2xl bg-primary/10 flex items-center justify-center">
        <Ticket className="size-8 text-primary" aria-hidden="true" />
      </div>
      <h1 class="font-heading text-3xl font-bold tracking-tight uppercase">Trickreport</h1>
      <p class="text-sm text-muted-foreground">Sign in to your workspace</p>
    </div>

    <div class="w-full max-w-md rounded-xl border bg-card text-card-foreground shadow-sm p-8 animate-in fade-in-0 slide-in-from-bottom-2 duration-300 fill-mode-backwards" style="animation-delay: 60ms">
      <LoginForm client:load />

      <div class="flex items-center gap-4 my-6">
        <div class="flex-1 h-px bg-border"></div>
        <span class="text-xs uppercase tracking-wide text-muted-foreground">or</span>
        <div class="flex-1 h-px bg-border"></div>
      </div>

      <p class="text-center text-sm text-muted-foreground">
        Don't have an account?
        <a href="/register" class="font-semibold text-primary hover:underline">Create one</a>
      </p>
    </div>
  </div>
</Layout>
