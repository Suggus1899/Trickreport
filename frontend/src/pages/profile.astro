---
import Layout from '../layouts/Layout.astro';
import { buttonVariants } from '../components/ui/button';
import { Badge } from '../components/ui/badge';
import { MfaSettings } from '../components/auth/MfaSettings';
import { getMe } from '../lib/api';

const token = Astro.cookies.get('trickreport_token')?.value;
if (!token) {
  return Astro.redirect('/login');
}

let me;
try {
  me = await getMe(token);
} catch {
  return Astro.redirect('/login');
}
---

<Layout title="Profile — Trickreport" user={{ name: me.name, role: me.role }}>
  <div class="max-w-4xl mx-auto py-8">
    <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
      <div>
        <h1 class="text-2xl font-bold">Profile</h1>
        <p class="text-sm text-muted-foreground">Your account and security settings</p>
      </div>
      <a href="/dashboard" class={buttonVariants({ variant: 'outline', size: 'sm' })}>Back to Dashboard</a>
    </div>

    <div class="flex flex-col gap-6">
      <div class="rounded-xl border bg-card p-5">
        <h2 class="text-lg font-semibold mb-4">Account details</h2>
        <div class="flex flex-col gap-3 text-sm">
          <div>
            <span class="text-muted-foreground">Name</span>
            <p class="font-semibold">{me.name}</p>
          </div>
          <div>
            <span class="text-muted-foreground">Email</span>
            <p class="font-semibold">{me.email}</p>
          </div>
          <div>
            <span class="text-muted-foreground">Role</span>
            <div class="mt-1">
              <Badge variant="secondary">{me.role.replace('_', ' ')}</Badge>
            </div>
          </div>
        </div>
      </div>

      <div class="rounded-xl border bg-card p-5">
        <h2 class="text-lg font-semibold mb-1">Multi-factor authentication</h2>
        <p class="text-sm text-muted-foreground">Add an extra layer of security to your account.</p>
        <MfaSettings client:load initialEnabled={!!me.mfa_enabled} />
      </div>
    </div>
  </div>
</Layout>
