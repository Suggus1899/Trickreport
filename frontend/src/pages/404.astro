---
import Layout from '../layouts/Layout.astro';
import { buttonVariants } from '../components/ui/button';
---

<Layout title="Not Found">
  <div class="min-h-screen flex items-center justify-center p-6">
    <div class="w-full max-w-md text-center rounded-xl border bg-card p-8">
      <p class="text-6xl font-bold text-primary mb-4">404</p>
      <h1 class="text-2xl font-bold mb-2">Page not found</h1>
      <p class="text-muted-foreground mb-8">The page you are looking for doesn't exist or has been moved.</p>
      <a href="/dashboard" class={buttonVariants({})}>Back to Dashboard</a>
    </div>
  </div>
</Layout>
