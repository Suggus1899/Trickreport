---
import Layout from '../../layouts/Layout.astro';
import { Badge } from '../../components/ui/badge';
import { buttonVariants } from '../../components/ui/button';
import { getArticle } from '../../lib/api';
import type { Article } from '../../lib/api';
import { ArrowLeft } from 'lucide-react';

const { id } = Astro.params;
const token = Astro.locals.token;
if (!token || !id) {
  return Astro.redirect('/login');
}

const user = Astro.locals.user!;
let article: Article | null = null;
let error = '';

try {
  article = await getArticle(id, token);
} catch (err) {
  error = err instanceof Error ? err.message : 'Failed to load article';
}

// Matches the backend: PUT /articles/{id} is admin/agent only.
const canWrite = user?.role === 'admin' || user?.role === 'agent';
---

<Layout title={article?.title || 'Article'} user={user ? { name: user.name, role: user.role } : undefined}>
  <div class="max-w-4xl mx-auto">
    <a href="/articles" class="inline-flex items-center gap-1.5 text-sm font-semibold text-muted-foreground hover:text-foreground transition-colors mb-4">
      <ArrowLeft className="size-4" aria-hidden="true" />
      Back to Knowledge Base
    </a>
    <div class="flex flex-wrap items-start justify-between gap-3 mb-6">
      <h1 class="font-heading text-2xl font-bold">
        {article?.title || 'Article'}
        {article && !article.published && (
          <Badge variant="secondary" className="ml-2 align-middle">Draft</Badge>
        )}
      </h1>
      {article && canWrite && (
        <a href={`/articles/${id}/edit`} class={buttonVariants({ variant: 'outline' })}>Edit</a>
      )}
    </div>

    {error && (
      <div class="rounded-xl border border-destructive/30 bg-destructive/5 p-4 text-sm text-destructive mb-6">{error}</div>
    )}

    {article && (
      <div class="rounded-xl border bg-card p-5">
        <div class="flex flex-wrap gap-2 mb-4">
          <Badge variant="outline">{article.category}</Badge>
          {article.tags && article.tags.length > 0 && article.tags.map((tag) => (
            <Badge variant="secondary">#{tag}</Badge>
          ))}
        </div>
        <p class="whitespace-pre-wrap">{article.content}</p>
        <div class="mt-6 text-sm text-muted-foreground">
          Written by {article.author_name || article.created_by} on {new Date(article.created_at).toLocaleString()}
        </div>
      </div>
    )}
  </div>
</Layout>
