---
import Layout from '../../layouts/Layout.astro';
import { buttonVariants } from '../../components/ui/button';
import { Badge } from '../../components/ui/badge';
import { getMe, getArticle } from '../../lib/api';
import type { Article } from '../../lib/api';

const { id } = Astro.params;
const token = Astro.cookies.get('trickreport_token')?.value;
if (!token || !id) {
  return Astro.redirect('/login');
}

let user;
let article: Article | null = null;
let error = '';

try {
  user = await getMe(token);
  article = await getArticle(id, token);
} catch (err) {
  error = err instanceof Error ? err.message : 'Failed to load article';
}
---

<Layout title={article?.title || 'Article'} user={user ? { name: user.name, role: user.role } : undefined}>
  <div class="max-w-4xl mx-auto">
    <div class="flex items-center justify-between mb-8">
      <a href="/articles" class={buttonVariants({ variant: 'outline', size: 'sm' })}>Back</a>
      <h1 class="text-2xl font-bold">{article?.title || 'Article'}</h1>
      <span></span>
    </div>

    {error && (
      <div class="rounded-xl border border-destructive/30 bg-destructive/5 p-4 text-sm text-destructive mb-6">{error}</div>
    )}

    {article && (
      <div class="rounded-xl border bg-card p-5">
        <div class="flex flex-wrap gap-2 mb-4">
          <Badge variant="outline">{article.category}</Badge>
          {article.tags && article.tags.length > 0 && article.tags.map((tag) => (
            <Badge variant="secondary">#{tag}</Badge>
          ))}
        </div>
        <p class="whitespace-pre-wrap">{article.content}</p>
        <div class="mt-6 text-sm text-muted-foreground">
          Written by {article.author_name || article.created_by} on {new Date(article.created_at).toLocaleString()}
        </div>
      </div>
    )}
  </div>
</Layout>
