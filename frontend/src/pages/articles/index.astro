---
import Layout from '../../layouts/Layout.astro';
import NeuCard from '../../components/NeuCard.astro';
import NeuButton from '../../components/NeuButton.astro';
import Pagination from '../../components/Pagination.astro';
import { getMe, getArticles } from '../../lib/api';

const token = Astro.cookies.get('trickreport_token')?.value;
if (!token) {
  return Astro.redirect('/login');
}

let user;
let articles;
let error = '';

const query = Astro.url.searchParams.get('q') || '';
const pageParam = parseInt(Astro.url.searchParams.get('page') || '1', 10);
const currentPage = isNaN(pageParam) || pageParam < 1 ? 1 : pageParam;
const perPage = 10;

try {
  user = await getMe(token);
  articles = await getArticles(token, query);
} catch (err) {
  error = err instanceof Error ? err.message : 'Failed to load articles';
}

const totalArticles = articles ? articles.length : 0;
const totalPages = Math.max(1, Math.ceil(totalArticles / perPage));
const pagedArticles = (articles || []).slice((currentPage - 1) * perPage, currentPage * perPage);
---

<Layout title="Knowledge Base" user={user ? { name: user.name, role: user.role } : undefined}>
  <div class="max-w-6xl mx-auto">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-3xl font-bold">Knowledge Base</h1>
        <p class="text-muted">Browse help articles and guides</p>
      </div>
    </div>

    {error && (
      <NeuCard variant="sunken" class="mb-6 text-rose-700">{error}</NeuCard>
    )}

    <NeuCard class="mb-6">
      <form method="GET" class="flex flex-col gap-3 sm:flex-row sm:items-end gap-5">
        <div class="flex flex-col gap-2 flex-1">
          <label for="q" class="text-sm font-semibold text-main ml-1">Search</label>
          <input id="q" name="q" type="text" placeholder="Search articles by title or content..." value={query} />
        </div>
        <NeuButton type="submit" variant="accent" size="md">Search</NeuButton>
        {query && (
          <a href="/articles" class="neu-transition px-6 py-3 rounded-2xl font-semibold text-muted hover:text-main">Clear</a>
        )}
      </form>
    </NeuCard>

    <NeuCard class="overflow-hidden p-0">
      <table class="w-full text-left">
        <thead class="neu-sunken text-xs uppercase text-muted">
          <tr>
            <th class="px-6 py-4 font-semibold">Title</th>
            <th class="px-6 py-4 font-semibold">Category</th>
            <th class="px-6 py-4 font-semibold">Author</th>
            <th class="px-6 py-4 font-semibold">Updated</th>
          </tr>
        </thead>
        <tbody class="divide-y">
          {pagedArticles.length > 0 ? pagedArticles.map((article) => (
            <tr class="hover:bg-white/30 transition-colors">
              <td class="px-6 py-4">
                <a href={`/articles/${article.id}`} class="font-semibold text-main hover:text-accent">
                  {article.title}
                </a>
              </td>
              <td class="px-6 py-4">
                <span class="px-3 py-1 rounded-full text-xs font-bold uppercase neu-convex text-main">{article.category}</span>
              </td>
              <td class="px-6 py-4 text-sm text-muted">
                {article.author_name || article.created_by}
              </td>
              <td class="px-6 py-4 text-sm text-muted">
                {new Date(article.updated_at || article.created_at).toLocaleDateString()}
              </td>
            </tr>
          )) : (
            <tr>
              <td colspan="4" class="px-6 py-12 text-center text-muted">
                No articles found{query ? ' for your search.' : ' yet.'}
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </NeuCard>

    {totalPages > 1 && (
      <Pagination currentPage={currentPage} totalPages={totalPages} href={query ? `/articles?q=${encodeURIComponent(query)}` : '/articles'} />
    )}
  </div>
</Layout>
