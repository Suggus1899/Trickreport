---
import Layout from '../../layouts/Layout.astro';
import { ArticleEditor } from '../../components/articles/ArticleEditor';
import { getMe, ApiAuthError } from '../../lib/api';

const token = Astro.cookies.get('trickreport_token')?.value;
if (!token) {
  return Astro.redirect('/login');
}

let user;
try {
  user = await getMe(token);
} catch (err) {
  if (err instanceof ApiAuthError) return Astro.redirect('/login');
  throw err;
}

// Matches the backend: POST /articles is admin/agent only.
if (user.role !== 'admin' && user.role !== 'agent') {
  return Astro.redirect('/articles');
}
---

<Layout title="New article" user={{ name: user.name, role: user.role }}>
  <div class="max-w-3xl mx-auto">
    <div class="mb-8">
      <a href="/articles" class="text-sm text-muted-foreground hover:text-foreground"
        >&larr; Knowledge Base</a
      >
      <h1 class="font-heading text-3xl font-bold mt-2">New article</h1>
      <p class="text-muted-foreground">Write a help article for your team and customers</p>
    </div>

    <div class="rounded-xl border bg-card p-6">
      <ArticleEditor client:load />
    </div>
  </div>
</Layout>
