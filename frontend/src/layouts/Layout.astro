---
import '../styles/tailwind.css';
import { ON_PREMISE } from '../lib/config';
import { Sidebar } from '../components/chrome/Sidebar';
import { GlobalSearch } from '../components/chrome/GlobalSearch';
import { NotificationBell } from '../components/chrome/NotificationBell';
import { KeyboardHelp } from '../components/chrome/KeyboardHelp';
import type { User } from '../lib/api';

export interface Props {
  title?: string;
  user?: Pick<User, 'name' | 'role'>;
}

const { title = 'Trickreport', user } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="no-referrer" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#6d5dfc" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <title>{title} — Trickreport</title>
    {/* External resources are only loaded in non-on-premise mode */}
    {!ON_PREMISE && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
      </>
    )}
    <script>
      import '../scripts/register-sw.ts';
    </script>
    {/* Apply persisted theme before paint to avoid flash */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('trickreport-theme');
          if (stored === 'dark') document.documentElement.classList.add('dark');
          else if (stored === 'light') document.documentElement.classList.add('light');
          else if (window.matchMedia('(prefers-color-scheme: dark)').matches) document.documentElement.classList.add('dark');
        } catch {
          // localStorage bloqueado (modo privado / cookies de terceros): sin
          // preferencia guardada nos quedamos con el tema claro por defecto.
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <a
      href="#main-content"
      class="absolute -left-full top-0 z-[200] focus:left-4 focus:top-4 rounded-lg border bg-card px-4 py-3 font-semibold shadow-md"
    >
      Skip to content
    </a>
    {user ? (
      <div class="flex min-h-screen">
        <Sidebar client:load user={user} pathname={Astro.url.pathname} />
        <main id="main-content" class="flex-1 p-6 overflow-auto">
          <div class="flex items-center gap-3 mb-6 flex-wrap">
            <GlobalSearch client:load />
            <div class="flex items-center gap-2 ml-auto">
              <NotificationBell client:load />
            </div>
          </div>
          <slot />
        </main>
        <KeyboardHelp client:load />
      </div>
    ) : (
      <slot />
    )}
  </body>
</html>
