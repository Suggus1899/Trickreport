# SSR (server-side) calls the backend directly and passes the token itself.
API_URL=http://localhost:8080

# Left empty on purpose: the browser uses relative paths (/api/v1/...) and the
# dev server proxies them to API_URL, so development is same-origin just like
# production behind the reverse proxy. That is what lets the httpOnly auth
# cookie reach the API from client-side island code.
# Set this to an absolute URL only when the API really is on another origin,
# and expect cookie auth not to work there.
PUBLIC_API_URL=
