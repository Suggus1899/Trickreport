package views

// TicketList renders a list of tickets.
templ TicketList(tickets []TicketData) {
	<h1>Tickets</h1>
	<div class="actions-bar">
		<a href="/tickets/new" class="btn btn-primary">+ New Ticket</a>
	</div>
	if len(tickets) == 0 {
		<div class="empty-state">
			<h3>No tickets yet</h3>
			<p>Create your first ticket to get started.</p>
		</div>
	} else {
		<div class="card" style="padding:0">
			<table>
				<thead>
					<tr>
						<th>ID</th>
						<th>Title</th>
						<th>Status</th>
						<th>Priority</th>
						<th>Created By</th>
						<th>Assigned To</th>
						<th>Created</th>
					</tr>
				</thead>
				<tbody>
					for _, t := range tickets {
						<tr>
							<td style="font-family:monospace;font-size:0.75rem">{ t.ID[:8] }</td>
							<td>
								<a href={ templ.SafeURL("/tickets/" + t.ID) } style="font-weight:500">{ t.Title }</a>
							</td>
							<td><span class={ statusBadgeClass(t.Status) }>{ t.Status }</span></td>
							<td><span class={ priorityBadgeClass(t.Priority) }>{ t.Priority }</span></td>
							<td>{ t.CreatorName }</td>
							<td>{ ptrStr(t.AssigneeName) }</td>
							<td style="color:var(--text-muted);font-size:0.75rem">{ formatTime(t.CreatedAt) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}
