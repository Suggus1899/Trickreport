package views

// ArticleList renders a list of knowledge base articles.
templ ArticleList(articles []ArticleData) {
	<h1>Knowledge Base</h1>
	<div class="actions-bar">
		<a href="/articles/new" class="btn btn-primary">+ New Article</a>
	</div>
	if len(articles) == 0 {
		<div class="empty-state">
			<h3>No articles yet</h3>
			<p>Create your first knowledge base article.</p>
		</div>
	} else {
		for _, a := range articles {
			<div class="card">
				<h2><a href={ templ.SafeURL("/articles/" + a.ID.String()) } style="text-decoration:none;color:var(--text)">{ a.Title }</a></h2>
				<div class="ticket-meta">
					<span class="badge badge-gray">{ a.Category }</span>
					if !a.Published {
						<span class="badge badge-yellow">Draft</span>
					}
					<span style="color:var(--text-muted);font-size:0.75rem">by { a.AuthorName } · { formatTime(a.CreatedAt) }</span>
				</div>
				<p style="color:var(--text-muted);margin-top:0.5rem">
					{ articleExcerpt(a.Content, 150) }
				</p>
			</div>
		}
	}
}

// ArticleDetail renders a single article.
templ ArticleDetail(a ArticleData) {
	<h1>{ a.Title }</h1>
	<div class="ticket-meta">
		<span class="badge badge-gray">{ a.Category }</span>
		if !a.Published {
			<span class="badge badge-yellow">Draft</span>
		}
		<span style="color:var(--text-muted);font-size:0.75rem">by { a.AuthorName } · { formatTime(a.CreatedAt) }</span>
	</div>
	if len(a.Tags) > 0 {
		<div style="display:flex;gap:0.25rem;flex-wrap:wrap;margin-bottom:1rem">
			for _, tag := range a.Tags {
				<span class="badge badge-blue">#{ tag }</span>
			}
		</div>
	}
	<div class="card">
		<div style="white-space:pre-wrap">{ a.Content }</div>
	</div>
	<div style="display:flex;gap:0.5rem;margin-top:1rem">
		<a href={ templ.SafeURL("/articles/" + a.ID.String() + "/edit") } class="btn btn-primary">Edit</a>
		<a href="/articles" class="btn btn-ghost">Back</a>
	</div>
}

// ArticleForm renders the create/edit article form.
templ ArticleForm(a *ArticleData) {
	<h1>New Article</h1>
	<div class="card">
		<form method="POST" action="/articles">
			<div class="form-group">
				<label for="title">Title</label>
				<input type="text" id="title" name="title" required autofocus value={ articleTitle(a) }/>
			</div>
			<div class="form-group">
				<label for="content">Content</label>
				<textarea id="content" name="content" required>{ articleContent(a) }</textarea>
			</div>
			<div class="form-group">
				<label for="category">Category</label>
				<input type="text" id="category" name="category" value={ articleCategory(a) } placeholder="general"/>
			</div>
			<div class="form-group">
				<label for="tags">Tags (comma-separated)</label>
				<input type="text" id="tags" name="tags" value={ articleTags(a) } placeholder="setup, billing"/>
			</div>
			<div class="form-group">
				<label>
					<input type="checkbox" name="published" value="true" style="width:auto" checked={ articlePublished(a) }/>
					Published
				</label>
			</div>
			<div style="display:flex;gap:0.5rem">
				<button type="submit" class="btn btn-primary">Save Article</button>
				<a href="/articles" class="btn btn-ghost">Cancel</a>
			</div>
		</form>
	</div>
}
