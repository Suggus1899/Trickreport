package views

// Layout renders the full HTML page with nav sidebar and content area.
templ Layout(data LayoutData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ data.Title } — Trickreport</title>
			<link rel="stylesheet" href="/static/css/app.css"/>
			<script src="https://unpkg.com/htmx.org@2.0.4" defer></script>
		</head>
		<body>
			<div class="app">
				if data.UserName != "" {
					<nav class="sidebar">
						<div class="sidebar-header">
							<a href="/dashboard" class="logo">Trickreport</a>
						</div>
						<ul class="nav-list">
							for _, item := range navItems(data.Path, data.UserRole) {
								<li class="nav-item">
									<a
										href={ templ.SafeURL(item.Path) }
										class={ "nav-link", templ.KV("active", item.Active) }
									>
										<svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={ item.Icon }/>
										</svg>
										<span>{ item.Label }</span>
									</a>
								</li>
							}
						</ul>
						<div class="sidebar-footer">
							<div class="user-info">
								<span class="user-name">{ data.UserName }</span>
								<span class="user-role">{ data.UserRole }</span>
							</div>
							<form method="POST" action="/auth/logout">
								<button type="submit" class="btn btn-ghost btn-sm">Logout</button>
							</form>
						</div>
					</nav>
				}
				<main class="content">
					@data.Content
				</main>
			</div>
		</body>
	</html>
}
