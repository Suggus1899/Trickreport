package views

// SLAList renders SLA policies.
templ SLAList(policies []SLAPolicyData) {
	<h1>SLA Policies</h1>
	if len(policies) == 0 {
		<div class="empty-state">
			<h3>No SLA policies configured</h3>
			<p>Configure SLA deadlines for each priority level.</p>
		</div>
	} else {
		<div class="card" style="padding:0">
			<table>
				<thead>
					<tr>
						<th>Priority</th>
						<th>Response Time (min)</th>
						<th>Resolution Time (min)</th>
						<th>Escalation (min)</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					for _, p := range policies {
						<tr>
							<td><span class={ priorityBadgeClass(p.Priority) }>{ p.Priority }</span></td>
							<td>{ intStr(p.ResponseTimeMinutes) }</td>
							<td>{ intStr(p.ResolutionTimeMinutes) }</td>
							<td>{ intStr(p.EscalationMinutes) }</td>
							<td>
								<a href={ templ.SafeURL("/admin/sla/" + p.Priority + "/edit") } class="btn btn-ghost btn-sm">Edit</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// SLAForm renders the SLA policy upsert form.
templ SLAForm(priority string, p *SLAPolicyData) {
	<h1>SLA Policy — { priority }</h1>
	<div class="card">
		<form method="POST" action={ templ.SafeURL("/admin/sla/" + priority) }>
			<div class="form-group">
				<label for="response_time">Response Time (minutes)</label>
				<input type="number" id="response_time" name="response_time_minutes" required value={ slaField(p, "response") } min="0"/>
			</div>
			<div class="form-group">
				<label for="resolution_time">Resolution Time (minutes)</label>
				<input type="number" id="resolution_time" name="resolution_time_minutes" required value={ slaField(p, "resolution") } min="0"/>
			</div>
			<div class="form-group">
				<label for="escalation">Escalation (minutes)</label>
				<input type="number" id="escalation" name="escalation_minutes" required value={ slaField(p, "escalation") } min="0"/>
			</div>
			<div style="display:flex;gap:0.5rem">
				<button type="submit" class="btn btn-primary">Save Policy</button>
				<a href="/admin/sla" class="btn btn-ghost">Cancel</a>
			</div>
		</form>
	</div>
}
