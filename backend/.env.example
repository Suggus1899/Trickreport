# ── Server ─────────────────────────────────────────────────────────────────
PORT=8080
ENV=development

# ── Database ───────────────────────────────────────────────────────────────
# NEVER commit real credentials. Use a local .env (gitignored).
DATABASE_URL=postgres://trickreport:CHANGE_ME@localhost:5432/trickreport?sslmode=disable
POSTGRES_USER=trickreport
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=trickreport

# ── Auth ───────────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_USE_openssl_rand_hex_32
JWT_EXP_HOURS=8
# In production, COOKIE_SECURE MUST be true (requires HTTPS)
COOKIE_SECURE=false

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:4321

# ── Bootstrap Admin ─────────────────────────────────────────────────────────
# Created on first startup if no users exist. Password is bcrypt-hashed.
ADMIN_EMAIL=admin@trickreport.local
ADMIN_PASSWORD=CHANGE_ME

# ── LDAP (optional) ────────────────────────────────────────────────────────
# Set LDAP_ENABLED=true to enable LDAP authentication
# When false, local email+password login is used (bcrypt)
LDAP_ENABLED=false
LDAP_HOST=ldap.yourcompany.com
LDAP_PORT=636
LDAP_USE_TLS=true
LDAP_BIND_DN=cn=serviceaccount,dc=yourcompany,dc=com
LDAP_BIND_PW=CHANGE_ME
LDAP_BASE_DN=dc=yourcompany,dc=com
LDAP_UID_ATTR=uid
