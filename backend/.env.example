# ── Server ─────────────────────────────────────────────────────────────────
PORT=8080

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://trickreport:trickreport@localhost:5432/trickreport?sslmode=disable

# ── Auth ───────────────────────────────────────────────────────────────────
# Generate a strong random secret for production: openssl rand -hex 32
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_EXP_HOURS=8
COOKIE_SECURE=false

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:4321

# ── LDAP (optional) ────────────────────────────────────────────────────────
# Set LDAP_ENABLED=true to enable LDAP authentication
# When false, local email+password login is used (bcrypt)
LDAP_ENABLED=false
LDAP_HOST=ldap.yourcompany.com
LDAP_PORT=389
LDAP_BIND_DN=cn=serviceaccount,dc=yourcompany,dc=com
LDAP_BIND_PW=serviceaccount_password
LDAP_BASE_DN=dc=yourcompany,dc=com
LDAP_UID_ATTR=uid
